                                        <label class="form-check-label" for="rijbewijsNee">Nee</label>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-secondary prev-step">Vorige</button>
                                <button type="button" class="btn btn-primary next-step">Volgende</button>
                            </div>
                            Step 3
                            <div class="form-step">
                                <div class="mb-3">
                                    <label class="form-label">Wat is uw hoofdvervoersmiddel?</label>
