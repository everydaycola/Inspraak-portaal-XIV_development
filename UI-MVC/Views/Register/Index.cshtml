@using UI_MVC.TempTenant
@model UI_MVC.Models.ViewModels.NewPanelMemberViewModel
@{
    ViewBag.Title = "Welkom";
    Layout = "_Layout";
}

@section Scripts{
    <script src="~/dist/register.entry.js" type="module"></script>
}

<div class="container mt-5">
    @if (Model.IsRegistrationOpen || Model.HasAnsweredQuestions)
    {
        <div class="card shadow-sm border-0">
            @if (Model.HasAnsweredQuestions)
            {
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="me-3">
                                <i class="bi bi-check-circle-fill text-success fs-1"></i>
                            </div>
                            <div>
                                <h4 class="card-title mb-0 text-success">Bedankt!</h4>
                                <small class="text-muted">Je hebt alle vragen ingevuld</small>
                            </div>
                        </div>

                        <p class="mb-2">
                            Indien u geselecteerd wordt voor dit panel, brengen we u via e-mail op de hoogte.
                        </p>

                        <div class="alert alert-secondary d-flex align-items-center" role="alert">
                            <div class="text-primary fw-bold">
                                @Model.Email
                            </div>
                        </div>

                        <a href="@($"/Register/AccountCreation?UserId={Model.UserId}")" class="btn btn-warning">
                            Ga naar account aanmaken (DEV BUTTON, REMOVE!!!!)
                        </a>
                        
                    </div>
                </div>
            }
            <partial name="_signUpFormPartial" model="Model"/>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="row g-0">
                    <div class="col-md-5 d-flex align-items-center justify-content-center" style="background:#f8f9fa;">
                        <img
                            src="https://media.istockphoto.com/id/1393370540/nl/foto/architecture-in-antwerp-city.jpg?s=612x612&w=0&k=20&c=qsEVkQCLeB2ob-oAMVfIXeex69ZQJqo64L33nSZqqqQ="
                            alt="Vragen" class="img-fluid w-100 h-100" style="object-fit:cover;">
                    </div>

                    <div class="col-md-7">
                        <div class="card-body">
                            <h4 class="card-title mb-0 text-warning">Helaas...</h4>
                            <small class="text-muted">De inschrijvingen zijn gesloten</small>
                            <p>Op dit moment is het niet meer mogelijk om je aan te melden voor dit panel.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>