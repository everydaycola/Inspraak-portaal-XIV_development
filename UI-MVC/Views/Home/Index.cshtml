@using DAL
@using UI_MVC.TempTenant
@{
    ViewData["Title"] = "Home Page";
}
@inject Organisation Organisation

@section Scripts{
    <script src="~/dist/index.entry.js" type="module"></script>
}

@if (Organisation.Id == null)
{
    <div class="card p-0 mt-5 col-11" style="height: 600px; overflow: hidden;">
        <div class="row g-0 h-100">
            <!-- Image on the left (50%) -->
            <div class="col-6 h-100">
                <img src="~/images/burgerpanel.jpg" 
                     class="img-fluid h-100 w-100" 
                     style="object-fit: cover;" 
                     alt="Inspraak Portaal">
            </div>
            <div class="col-6 d-flex align-items-start h-100">
                <div class="card-body">
                    <img class="header-image" style="width:40%; margin: 0;" src="~/images/icons/inspraak_portaal_light_mode.svg" alt="inspraak-portaal-logo"/>
                    <h2>Welkom!</h2>
                    <p>Het Inspraak Portaal is een platform die het organiseren van burgerpanels vereenvoudigd.</p>
                    <p>Zelf interesse in een burgerpanel? Meld je dan aan voor jou organisatie!</p>
                    <button class="btn btn-primary">Mijn organisatie aanmelden</button>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center">
        <h1 class="display-4">Welcome to @Organisation.Name</h1>
        <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
    </div>
}