@using Domain
@using Domain.Interfaces.Posts
@using Domain.Tenant
@using Microsoft.IdentityModel.Tokens
@{
    ViewData["Title"] = "Home Page";
    var isEditing = ViewBag.IsEditing as bool? ?? false;
}
@inject Organisation Organisation
@model UI_MVC.Models.ViewModels.HomePanelsViewModel

@if (Organisation.Id == null)
{
    @if (User.IsInRole(CustomIdentityConstants.AdminRole))
    {
        @if (!isEditing)
        {
            <a asp-action="Edit" class="btn btn-primary">bewerken</a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-primary">annuleer</a>
        }
    }

    <div class="card p-0 mt-5 m-4">
        <div class="row flex-row g-0 h-100 flex-column flex-lg-row">
            <div class="col-12 col-lg-6 d-flex align-items-start h-50 h-lg-100">
                <div class="card-body h-25">
                    <div class="row mx-2 m-4">
                        <h2>Nieuw bij burgerpanels?</h2>
                        @if (User.IsInRole(CustomIdentityConstants.AdminRole) && isEditing)
                        {
                            //TODO add edit field for this text.
                        }
                        else
                        {
                            @if (!Model.DiscoverConceptText.IsNullOrEmpty())
                            {
                                <p>@Model.DiscoverConceptText</p>
                            }
                            else
                            {
                                <p>
                                    Het Inspraak Portaal vereenvoudigt het organiseren van burgerpanels. Ben je nog niet
                                    zeker of een burgerpanel iets voor jouw initiatief is?<br/>
                                    Beantwoord dan enkele korte vragen om te ontdekken hoe een burgerpanel jou kan
                                    helpen!
                                </p>
                            }
                        }
                        <a href="./ExploreConcept" class="btn btn-primary" >Ontdek of het iets voor jou is</a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6 h-50 h-lg-100">
                <img src="~/images/nieuw_bij_burgerpanels.jpg"
                     class="img-fluid w-100 h-100"
                     style="object-fit: cover;"
                     alt="Inspraak Portaal">
            </div>
        </div>
    </div>


    <div class="card p-0 mt-5 m-4">
        <div class="row flex-row g-0 h-100 flex-column flex-lg-row">
            <!-- Image on the left (or top on small screens) -->
            <div class="col-12 col-lg-6 h-50 h-lg-100">
                <img src="~/images/burgerpanel.jpg"
                     class="img-fluid w-100 h-100"
                     style="object-fit: cover;"
                     alt="Inspraak Portaal">
            </div>
            <!-- Content on the right (or bottom on small screens) -->
            <div class="col-12 col-lg-6 d-flex align-items-start h-50 h-lg-100">
                <div class="card-body">
                    <div class="row mx-2 m-4">
                        <h2>Wat doet het inspraak portaal?</h2>
                        @if (User.IsInRole(CustomIdentityConstants.AdminRole) && isEditing)
                        {
                            //TODO add edit field for this text.
                        }
                        else
                        {
                            @if (!Model.AboutInspraakPortaalText.IsNullOrEmpty())
                            {
                                <p>@Model.AboutInspraakPortaalText</p>
                            }
                            else
                            {
                                <p>Het Inspraak Portaal is een platform die het organiseren van burgerpanels
                                    vereenvoudigd.<br/>
                                    Zelf interesse in een burgerpanel? Meld je dan aan voor jouw organisatie!</p>
                            }
                        }
                        <a href="./Organisation/OrganisationCreation" class="btn btn-primary">Mijn organisatie
                            aanmelden</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container mt-5">
        <h2>Publieke Panels</h2>
        <div class="card border-0 d-flex flex-column">
            @foreach (var panel in Model.Panels)
            {
                @foreach (var timeLine in panel.Timelines)
                {
                    if (
                        timeLine.Posts.Any(post => post.IsGloballyVisible) ||
                        timeLine.Posts.Any(post => post is SuggestionPost suggestionPost && suggestionPost.Suggestions.Any(sp => sp.IsGloballyVisible)
                        ))
                    {
                        <a class="card col-5 m-2"
                           href="@Url.Action("Index", "PanelProjectPage", new { id = panel.Id })">
                            <h3 class="card-title p-4">@panel.Name</h3>
                        </a>
                    }
                }
            }
        </div>
    </div>
}