@using Domain.Interfaces
@using Domain.Interfaces.Posts
@model UI_MVC.Models.Dto.ProjectPage.ProjectPageDto

@{
    Layout = "_Layout";
}
<h2>Projectpagina</h2>
<h2>@Model.Panel.Name</h2>

@if (User.IsInRole(CustomIdentityConstants.OrganisatieRole))
{
    <div class="mb-3">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addTextModal">
            Text toevoegen aan de project pagina.
        </button>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addBestandModal">
            Bestand toevoegen aan de project pagina.
        </button>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addWerksessieModal">
            Werksessie inplannen
        </button>
    </div>

    @if(User.IsInRole(CustomIdentityConstants.OrganisatieRole)){
    <!-- Text Modal -->
    <div class="modal fade" id="addTextModal" tabindex="-1" aria-labelledby="addTextModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title" id="addTextModalLabel">Informatie toevoegen aan de projectpagina</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
                </div>
                <div class="modal-body">
                    <form id="addTextForm" asp-action="AddTextPost" method="post">
                        <input type="hidden" name="panelId" value="@Model.Panel.Id"/>
    
                        <div class="mb-3">
                            <label for="textTitleInput" class="form-label">Titel</label>
                            <input type="text" class="form-control" id="textTitleInput" name="title" placeholder="Voer de titel in" required />
                        </div>

                        <div class="mb-3">
                            <label for="projectTextInput" class="form-label">Voer je tekst in</label>
                            <textarea class="form-control" id="projectTextInput" name="content" rows="6" placeholder="Voeg hier je projecttekst toe..." required></textarea>
                        </div>
                        
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="PLvisibleCheckbox" value="true" name="visibleForPanelMember" checked/>
                            <label class="form-check-label" for="PLvisibleCheckbox"
                                   title="Niet aangevinkt zorgt ervoor dat enkel organisatiebeheer + projectgroep deze post kan bekijken.">
                                Zichtbaar voor panelleden?
                            </label>
                        </div>
                        
                        <h3>Panelleden op de hoogte brengen?</h3>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="informPeopleViaMail" value="true" name="informPeopleViaMail" checked/>
                            <label class="form-check-label" for="informPeopleViaMail"
                                   title="Wanneer dit vakje is aangevinkt worden de betreffende personen op de hoogte gebracht.">
                                Iedereen op de hoogte brengen via mail?
                            </label>
                        </div>
                        
                        <div class="text-end">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                            <button type="submit" class="btn btn-success">Opslaan</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Image Upload Modal -->
    <div class="modal fade" id="addBestandModal" tabindex="-1" aria-labelledby="addBestandModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title" id="addBestandModalLabel">Bestand toevoegen aan de projectpagina</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
                </div>
                <div class="modal-body">
                    <form id="addImageForm" asp-action="AddDocumentPost" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="panelId" value="@Model.Panel.Id"/>

                        <div class="mb-3">
                            <label for="docTitleInput" class="form-label">Titel</label>
                            <input type="text" class="form-control" id="docTitleInput" name="title" placeholder="Voer de titel in" required />
                        </div>

                        <div class="mb-3">
                            <label for="imageUpload" class="form-label">Afbeelding of PDF uploaden</label>
                            <input type="file" class="form-control" id="imageUpload" name="file" accept="image/*, .pdf, .txt" required/>
                        </div>
                        
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="DocPLvisibleCheckbox" value="true" name="visibleForPanelMember" checked/>
                            <label class="form-check-label" for="DocPLvisibleCheckbox"
                                   title="Niet aangevinkt zorgt ervoor dat enkel organisatiebeheer + projectgroep deze post kan bekijken.">
                                Zichtbaar voor panelleden?
                            </label>
                        </div>
                        
                        <h3>Panelleden op de hoogte brengen?</h3>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="informPeopleViaMail" value="true" name="informPeopleViaMail" checked/>
                            <label class="form-check-label" for="informPeopleViaMail"
                                   title="Wanneer dit vakje is aangevinkt worden de betreffende personen op de hoogte gebracht.">
                                Iedereen op de hoogte brengen via mail?
                            </label>
                        </div>
                        
                        <div class="text-end">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                            <button type="submit" class="btn btn-success">Uploaden</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    /*WERKSESSIE AANMAKEN.*/
    <div class="modal fade" id="addWerksessieModal" tabindex="-1" aria-labelledby="addWerksessieModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="addWerksessieModalLabel">Werksessie aanmaken</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
            </div>
            <div class="modal-body">
                <form id="addWerksessieForm" asp-action="AddWerksessiePost" method="post">
                    <input type="hidden" name="panelId" value="@Model.Panel.Id"/>

                    <div class="mb-3">
                        <label for="sessionTitleInput" class="form-label">Titel van de werksessie</label>
                        <input type="text" class="form-control" id="sessionTitleInput" name="title" placeholder="Voer de titel in" required />
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="sessionDateInput" class="form-label">Datum van de werksessie</label>
                            <input type="date" class="form-control" id="sessionDateInput" name="sessionDate" required />
                        </div>
                        <div class="col-md-6">
                            <label for="sessionTimeInput" class="form-label">Tijdstip</label>
                            <input type="time" class="form-control" id="sessionTimeInput" name="sessionTime" required />
                        </div>
                    </div>
                    <h3>Panelleden op de hoogte brengen?</h3>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="informPeopleViaMail" value="true" name="informPeopleViaMail" checked/>
                        <label class="form-check-label" for="informPeopleViaMail"
                               title="Wanneer dit vakje is aangevinkt worden de betreffende personen op de hoogte gebracht.">
                            Iedereen op de hoogte brengen via mail?
                        </label>
                    </div>
                    <div class="text-end">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                        <button type="submit" class="btn btn-primary">Inplannen</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
    }
}

@foreach (var post in Model.Panel.Posts.OrderByDescending(p => p.CreatedAt))
{
    @if (
        post.isVisibleForPanelMembers || (!post.isVisibleForPanelMembers && !User.IsInRole(CustomIdentityConstants.PanelMemberRole))
    )
    {
        @if (post is TextPost textPost)
        {
            <div class="timeline-item mb-4 p-3 border rounded shadow-sm bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-1">@textPost.Title</h5>
                    <small class="text-muted">@textPost.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                </div>
                <p class="mt-2 mb-0">@textPost.Content</p>
            </div>
        }

        @if (post is DocumentPost docPost)
        {
            <div class="timeline-item mb-4 p-3 border rounded shadow-sm bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-1">@docPost.Title</h5>
                    <small class="text-muted">@docPost.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                </div>
                @if (
                    docPost.DocumentName.Split('.').Last().ToLower() == "pdf" ||
                    docPost.DocumentName.Split('.').Last().ToLower() == "txt"
                )
                {
                    <a href="@Url.Action("GetFile", "Storage", new { fileName = docPost.DocumentName })" target="_blank" class="btn btn-outline-primary mt-2">
                        Document bekijken
                    </a>
                }

                else
                {
                    <img src="@Url.Action("GetFile", "Storage", new { fileName = docPost.DocumentName })" class="img-fluid mt-2"/>
                }
            </div>
        }
         @if (post is MeetingPost meetingPost)
         {
             <div class="timeline-item mb-4 p-3 border rounded shadow-sm bg-white">
                 <div class="d-flex justify-content-between align-items-center">
                     <h5 class="mb-1">@meetingPost.Title</h5>
                     <small class="text-muted">@meetingPost.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                 </div>
                 <h6 class="text-muted mt-3">Verslagen:</h6>
                 <div class="d-flex flex-column gap-2">
                     @foreach(string documentName in meetingPost.DocumentNames)
                     {
                         <a href="@Url.Action("GetFile", "Storage", new { fileName = documentName })" target="_blank" class="btn btn-outline-primary">
                             Document bekijken
                         </a>
                     }
                 </div>
                 <!-- Dropdown toggle for upload -->
                 <div class="mt-3">
                     <button class="btn btn-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#uploadCollapse-@meetingPost.Id" aria-expanded="false" aria-controls="uploadCollapse-@meetingPost.Id">
                         + Voeg verslag toe
                     </button>
                     <div class="collapse mt-2" id="uploadCollapse-@meetingPost.Id">
                         <form method="post" enctype="multipart/form-data" asp-action="AddSummaryToMeetingPost">
                             <input type="hidden" name="MeetingId" value="@meetingPost.Id" />
                             <input type="hidden" name="panelId" value="@Model.Panel.Id"/>
                             <div class="mb-2">
                                 <input type="file" class="form-control" name="VerslagFile" required />
                             </div>
                             <button type="submit" class="btn btn-primary">Uploaden</button>
                         </form>
                     </div>
                 </div>
             </div>
         }
    }
    
}