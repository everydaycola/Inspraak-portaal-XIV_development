@using Domain.CitizenPanel
@using UI_MVC.Models.ViewModels
@model UI_MVC.Models.ViewModels.ProjectPageViewModel

@{
    Layout = "_Layout";
}

@section Scripts{
    <script src="~/dist/suggestionVoting.entry.js" type="module"></script>
    <script src="~/dist/shareButtonPartial.entry.js" type="module"></script>
    <script src="~/dist/suggestionVisibility.entry.js" type="module"></script>
}

<div class="container mt-5">
    <div class="row m-2">
        <h2>Projectpagina</h2>
    </div>

    <div id="modal-root" class="hidden" data-open-modal="@ViewBag.OpenModal"></div>

    <div class="row" style="min-height: 60vh;">
        <!-- Left column: two stacked cards -->
        <div class="col-3 d-flex flex-column gap-3">
            <div class="card shadow-sm border-0 flex-fill">
                <div class="card-body">
                    <h3>Welkom!</h3>
                    <p>We organiseren een burgerpanel om inzicht te krijgen in de ervaring omtrent
                        verkeersveiligheid?</p>
                    <h4>De werking?</h4>
                    <p>Tijdens een werksessie komen we allemaal samen om informatie op te doen over gerelateerde
                        onderwerpen begeleid door professionals. Of om er over te discusieren.</p>
                    <br/>
                    <p>Zo'n werksessie wordt vroegtijdig ingepland en kan je zien op deze pagina. ook ontvang je een
                        e-mail van elke werksessie die ingepland wordt.</p>
                    <br/>
                    <p>OOk zul je op deze pagina jouw stem kunnen uitbrengen op aanbevelingen op basis van de discussie
                        sessies!</p>
                </div>
            </div>
            <div class="card shadow-sm border-0 flex-fill">
                <div class="card-body">
                    <h2>Suggestion posts here.</h2>
                </div>
            </div>
        </div>
        
        

        
        <div class="col-8 d-flex flex-column">
            <div class="col">
                <div class="h-100">
                    <button class="btn btn-primary d-flex align-items-center gap-2 w-100" data-bs-toggle="modal"
                            data-bs-target="#addTimeLineModal">
                        <i class="bi bi-collection"></i>
                        Nieuwe tijdlijn aanmaken
                    </button>
                </div>
            </div>
            
            @foreach (var timeLine in Model.Panel.Timelines)
            {
                <partial name="_Posts"
                         model="@(new TimeLineViewModel
                                {
                                    PanelId = Model.Panel.Id,
                                    CurrentUser = Model.CurrentUser,
                                    TimeLineId = timeLine.Id,
                                    Posts = timeLine.Posts
                                })"/>
            }
        </div>
    </div>
</div>

<!-- timeline Modal -->
<div class="modal fade" id="addTimeLineModal" tabindex="-1" aria-labelledby="addTimeLineModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="addTimeLineModalLabel">Suggestie toevoegen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Sluiten"></button>
            </div>
            <div class="modal-body">
                <form id="addTimeLineForm" asp-action="addTimeLine" method="post">
                    @if (ViewBag.OpenModal == "addTimeLineModal")
                    {
                        <div asp-validation-summary="All" class="alert alert-danger"></div>
                    }
                    <input type="hidden" name="panelId" value="@Model.Panel.Id"/>
                    <div class="mb-3">
                        <label for="titleInput" class="form-label">TimeLine Titel</label>
                        <input type="text" class="form-control" id="titleInput" name="title"
                               placeholder="Voer een titel in." required/>
                    </div>

                    <div class="text-end">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren
                        </button>
                        <button type="submit" class="btn btn-success">Opslaan</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>