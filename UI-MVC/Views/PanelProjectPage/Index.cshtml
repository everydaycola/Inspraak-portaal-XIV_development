@using UI_MVC.Models.ViewModels
@model UI_MVC.Models.ViewModels.ProjectPageViewModel

@{
    Layout = "_Layout";
}

@section Scripts{
    <script src="~/dist/suggestionVoting.entry.js" type="module"></script>
    <script src="~/dist/shareButtonPartial.entry.js" type="module"></script>
    <script src="~/dist/suggestionVisibility.entry.js" type="module"></script>
}

<div class="container mt-5">
    <div class="row m-2">
        <h2>Projectpagina</h2>
    </div>

    <div id="modal-root" class="hidden" data-open-modal="@ViewBag.OpenModal"></div>
    
    <div class="row" style="min-height: 60vh;">
        <!-- Left column: two stacked cards -->
        <div class="col-3 d-flex flex-column gap-3">
            <div class="card shadow-sm border-0 flex-fill">
                <div class="card-body">
                    <h3>Welkom!</h3>
                    <p>We organiseren een burgerpanel om inzicht te krijgen in de ervaring omtrent
                        verkeersveiligheid?</p>
                    <h4>De werking?</h4>
                    <p>Tijdens een werksessie komen we allemaal samen om informatie op te doen over gerelateerde
                        onderwerpen begeleid door professionals. Of om er over te discusieren.</p>
                    <br/>
                    <p>Zo'n werksessie wordt vroegtijdig ingepland en kan je zien op deze pagina. ook ontvang je een
                        e-mail van elke werksessie die ingepland wordt.</p>
                    <br/>
                    <p>OOk zul je op deze pagina jouw stem kunnen uitbrengen op aanbevelingen op basis van de discussie
                        sessies!</p>
                </div>
            </div>
            <div class="card shadow-sm border-0 flex-fill">
                <div class="card-body">
                    <h2>Suggestion posts here.</h2>
                </div>
            </div>
        </div>

        <div class="col-8 d-flex flex-column">
            <partial name="_Posts"
                     model="@(new PostListViewModel
                            {
                                CurrentUser = Model.CurrentUser,
                                PanelId = Model.Panel.Id,
                                Posts = Model.Panel.Posts
                            })"/>
        </div>
    </div>
</div>