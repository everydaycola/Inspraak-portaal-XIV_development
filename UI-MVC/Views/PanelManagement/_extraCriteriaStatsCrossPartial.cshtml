@model ExtraCriteriaDto
@{
    var critCount = Model.CriteriaMemberCount.Values.Count;
    var criteriaList = Model.CriteriaMemberCount.Keys.Order().ToList();
    var options = criteriaList.Select(key => Model.CriteriaMemberCount[key].Keys.ToList()).ToList();
    var lengths = options.Select(k => k.Count).ToList();
    // creates a list of the multiple of all numbers behind it in the original list.
    var rowCounts = lengths
        .Select((_, index) => lengths
            .Skip(index + 1)
            .DefaultIfEmpty(1)
            .Aggregate(1, (product, num) => product * num))
        .ToList();

    var indexes = Enumerable.Repeat(0, options.Count).ToList();
    var rowcount = lengths.Aggregate(1, (product, num) => product * num);
}

<table class="table">
    <thead class="table-primary">
    <tr>
        @foreach (var critName in criteriaList)
        {
            <th scope="col" class="text-center">@critName</th>
        }
        <th>registrations</th>
    </tr>
    </thead>
    <tbody>
    @* every table row *@
    @for (var i = 0; i < rowcount; i++)
    {
        <tr>
            @* variable for keeping track of the distribution and key for dict *@
            @{
                var distribution = 1.0;
                var key = new List<string>();
            }
            @* every table column for criteria. *@
            @for (var j = 0; j < critCount; j++)
            {
                var option = options[j][indexes[j] % lengths[j]];
                distribution *= Model.DesiredCriteriaCount[criteriaList[j]][option];
                key.Add(option);
                if (i % rowCounts[j] > 0) continue;
                <th class="align-middle text-center border-top border-black" rowspan="@rowCounts[j]">@option</th>
                indexes[j]++;
            }
            <th class="text-center">
                @{
                    var stringKey = string.Join("|", key);
                    if (!Model.CriteriaGroupAbsoluteMemberCount.TryGetValue(stringKey, out var count))
                    {
                        <div class="p-3 text-danger-emphasis bg-danger-subtle border border-danger-subtle">
                            Something went wrong
                        </div>
                    }

                    var needed = (int) (distribution * Model.DesiredRegistrationCount);
                    if (needed == 0) continue;
                }
                @count out of @needed (@(distribution * 100)% of total)
                <div class="progress"
                     role="progressbar"
                     aria-valuenow="@count"
                     aria-valuemin="0"
                     aria-valuemax="@needed">
                    <div class="progress-bar"
                         style="width: @((int)((double)count / needed * 100))%">
                        @((double) count / needed * 100)%
                    </div>
                </div>
            </th>
        </tr>
    }
    </tbody>
</table>
