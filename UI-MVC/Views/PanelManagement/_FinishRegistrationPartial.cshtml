@model UI_MVC.Models.Dto.PanelManagementDto


<div class="container mt-5">
    <div class="alert alert-warning text-center" role="alert">
        <h4 class="alert-heading">U gaat de inschrijvingsfase afronden</h4>
        <p> Er zijn <strong>@Model.ExtraCriteriaDto.SuccessfulRegistrationCount</strong> van de <strong>@(Model.PanelSize + Model.AmountOfReserveInvites)</strong>
            inschrijvingen gelukt.</p>
        @if (Model.ExtraCriteriaDto.SuccessfulRegistrationCount > Model.PanelSize + Model.AmountOfReserveInvites)
        {
            <p>U heeft <strong>@(Model.ExtraCriteriaDto.SuccessfulRegistrationCount - Model.PanelSize + Model.AmountOfReserveInvites)</strong> reserve inschrijvingen
            </p>
        }
        else
        {
            <p>U mist nog <strong>@(Model.PanelSize + Model.AmountOfReserveInvites - Model.ExtraCriteriaDto.SuccessfulRegistrationCount)</strong> inschrijvingen</p>
        }
        <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#newphase">
            Toon criteria statistieken
        </button>

        @if (Model.AnyCrossCriteria || Model.AnyUnknownCriteria)
        {
            <div class="accordion" id="criteriaAccordion">
                @if (Model.AnyCrossCriteria)
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="crossCriteriaHeading">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#crossCriteriaCollapse" aria-expanded="false"
                                    aria-controls="crossCriteriaCollapse">
                                Gekruiste criteria
                            </button>
                        </h2>
                        <div id="crossCriteriaCollapse" class="accordion-collapse collapse"
                             aria-labelledby="crossCriteriaHeading" data-bs-parent="#criteriaAccordion">
                            <div class="accordion-body">
                                @Html.Partial("_extraCriteriaStatsCrossPartial", Model.ExtraCriteriaDto)
                            </div>
                        </div>
                    </div>
                }

                @if (Model.AnyUnknownCriteria)
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="singleCriteriaHeading">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#singleCriteriaCollapse" aria-expanded="false"
                                    aria-controls="singleCriteriaCollapse">
                                Niet gekruiste / onbekende criteria
                            </button>
                        </h2>
                        <div id="singleCriteriaCollapse" class="accordion-collapse collapse"
                             aria-labelledby="singleCriteriaHeading" data-bs-parent="#criteriaAccordion">
                            <div class="accordion-body">
                                @Html.Partial("_extraCriteriaStatsPartial", Model.ExtraCriteriaDto)
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                <h4 class="alert-heading">Geen criteria</h4>
                <p class="mb-0">Er zijn geen criteria ingesteld voor dit panel.</p>
            </div>
        }


        <!-- End Registration Form -->
        <div class="d-flex justify-content-center m-4">
            <form method="post" asp-controller="PanelManagement" asp-action="EndRegistration"
                  class="card shadow-lg border-0 rounded-3" style="max-width: 550px; width: 100%;">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 text-center">Registratie Afronden</h5>
                </div>
                <div class="card-body p-4">
                    <input type="hidden" name="panelId" value="@Model.PanelId"/>

                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Let op: Deze actie kan niet ongedaan worden gemaakt.
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-danger btn-lg" type="submit">
                            <i class="bi bi-x-circle me-2"></i>Beëindig de Registratie
                        </button>
                    </div>
                </div>
            </form>
        </div>
        <hr>
        <strong class="mb-0">Deze actie kan niet ongedaan gemaakt worden.</strong>
        <strong class="mb-0">De oude QR-codes zullen niet meer werken???</strong>
    </div>
</div>