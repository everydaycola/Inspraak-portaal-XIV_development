@model UI_MVC.Models.Dto.PanelManagementDto


<div class="container mt-5">
    <div class="alert alert-warning text-center" role="alert">
        <h4 class="alert-heading">U gaat de inschrijvingsfase afronden</h4>
        <p> Er zijn <strong>@Model.ExtraCriteriaViewModel.SuccessfulRegistrationCount</strong> van de <strong>@Model.PanelSize</strong>
            inschrijvingen gelukt.</p>
        @if (Model.ExtraCriteriaViewModel.SuccessfulRegistrationCount > Model.PanelSize)
        {
            <p>U heeft <strong>@(Model.ExtraCriteriaViewModel.SuccessfulRegistrationCount - Model.PanelSize)</strong> reserve inschrijvingen
            </p>
        }
        else
        {
            <p>U mist nog <strong>@(Model.PanelSize - Model.ExtraCriteriaViewModel.SuccessfulRegistrationCount)</strong> inschrijvingen</p>
            @* knop voor volgende faze *@
        }
        <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#newphase">
            Begin een nieuwe fase voor loting van users (not working)
        </button>

        <!-- Collapsible content (hidden by default) -->
        <div class="collapse" id="newphase">

            <div class="card m-3">
                <h5 class="card-header text-center">Extra Criteria Statistieken</h5>
                <div class="m-2 justify-content-center">
                    @Html.Partial("_extraCriteriaStatsPartial", Model.ExtraCriteriaViewModel)
                </div>
            </div>
            <p>Dit panel heeft een actuele response rate van <strong>@((double) Model.ExtraCriteriaViewModel.SuccessfulRegistrationCount / Model.TotalInvitesNeeded)%</strong> (@Model.ExtraCriteriaViewModel.SuccessfulRegistrationCount out of @Model.TotalInvitesNeeded)</p>
            <div class="d-flex justify-content-center">
                <form method="post" asp-controller="PanelManagement" asp-action="NewPhase"
                      class="card p-4 shadow-lg border-light">
                    <div class="mb-3">
                        <input type="hidden" name="guid" value="@Model.PanelId"/>
                    </div>
                    <div class="mb-3">
                        <p>Als u een correctie wilt doen aan de response rate, dan kan u dit hier doen. Er zal berekent worden hoeveel uitnodigingen er nog nodig zijn en deze zullen aangemaakt worden.</p>
                        <label for="responseRate" class="form-label">Response Rate</label>
                        <input id="responseRate" type="number" name="responseRate" min="0" max="1" step="0.01"
                               class="form-control"
                               placeholder="Laat leeg voor originele response rate"/>
                    </div>
                    <div class="text-center">
                        <button class="btn btn-primary px-4 py-2" type="submit">Begin een nieuwe fase voor loting
                            van users
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#end">
            Begin een nieuwe fase voor loting van users
        </button>

        <!-- Collapsible content (hidden by default) -->
        <div class="collapse" id="end">

            <div class="card m-3">
                <h5 class="card-header text-center">Extra Criteria Statistieken</h5>
                <div class="m-2 justify-content-center">
                    @Html.Partial("_extraCriteriaStatsPartial", Model.ExtraCriteriaViewModel)
                </div>
            </div>
            <p>Dit panel heeft een actuele response rate van <strong>@((double) Model.ExtraCriteriaViewModel.SuccessfulRegistrationCount / Model.TotalInvitesNeeded)%</strong> (@Model.ExtraCriteriaViewModel.SuccessfulRegistrationCount out of @Model.TotalInvitesNeeded)</p>
            <div class="d-flex justify-content-center">
                <form method="post" asp-controller="PanelManagement" asp-action="EndRegistration"
                      class="card p-4 shadow-lg border-light">
                    <div class="mb-3">
                        <input type="hidden" name="guid" value="@Model.PanelId"/>
                    </div>
                    <div class="mb-3">
                        <p>Als u een correctie wilt doen aan de response rate, dan kan u dit hier doen. Er zal berekent worden hoeveel uitnodigingen er nog nodig zijn en deze zullen aangemaakt worden.</p>
                        <label for="responseRate" class="form-label">Response Rate</label>
                        <input id="responseRate" type="number" name="responseRate" min="0" max="1" step="0.01"
                               class="form-control"
                               placeholder="Laat leeg voor originele response rate"/>
                    </div>
                    <div class="text-center">
                        <button class="btn btn-primary px-4 py-2" type="submit">Begin een nieuwe fase voor loting
                            van users
                        </button>
                    </div>
                </form>
            </div>
        </div>
        <hr>
        <strong class="mb-0">Deze actie kan niet ongedaan gemaakt worden.</strong>
        <strong class="mb-0">De oude QR-codes zullen blijven werken???</strong>
    </div>

    <div class="d-flex justify-content-center gap-2">
        <a asp-action="Index" class="btn btn-secondary px-4 py-2">Terug</a>
        <form method="post" asp-controller="Register" asp-action="RegisterRandomUsers"
              class="d-flex align-items-center gap-2">
            <input type="hidden" name="guid" value="@Model.PanelId"/>
            <input type="number" name="count" min="1" class="form-control w-auto" placeholder="Enter count"/>
            <button class="btn btn-primary px-4 py-2" type="submit">voeg dummy users toe</button>
        </form>
    </div>
</div>