@using Microsoft.IdentityModel.Tokens
@model UI_MVC.Models.ViewModels.PeopleManagementViewModel

@if (!Model.PotentialPanelMembersViewModel.PanelMembers.IsNullOrEmpty())
{
    <button class="btn btn-primary mt-3"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#panelMembersCollapse"
            aria-expanded="false"
            aria-controls="panelMembersCollapse">
        Aangemelde panelleden weergeven
    </button>
    <div class="collapse mt-4" id="panelMembersCollapse">
        <div class="card card-body">
            <table class="table table-striped table-bordered">
                <thead class="thead-dark">
                <tr>
                    <th>Email</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var panelMember in Model.PotentialPanelMembersViewModel.PanelMembers)
                {
                    <tr>
                        <td>
                            @panelMember.Email
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        <small>Nog geen panelmembers aangemeld</small>
    </div>
}
