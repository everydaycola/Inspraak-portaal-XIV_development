@model IEnumerable<Domain.CitizenPanel.CriteriaGroup>


<div class="card shadow-sm border-0 col-8">
    <div class="card-header bg-primary text-white">
        <h2 class="mb-0">Verdeling extra criteria</h2>
    </div>
    <div class="card-body">
        <ul>
            @foreach (var group in Model.Where(g => !g.IsADefaultGroup))
            {
                <li>
                    @group.Name: @group.PanelMembers.Count() leden
                </li>
            }
        </ul>
    </div>
</div>