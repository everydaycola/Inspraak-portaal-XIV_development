@model ExtraCriteriaDto

@{
    var desiredCriteriaCountDictionary = Model.Criteria
        .Where(c => !c.IsDistributionKnown)
        .ToDictionary(
        criteria => criteria.Name,
        criteria => criteria.AnswerOptions.ToDictionary(
            option => option.Option,
            option => option.DistributionPercentage
        )
    );
}

<h3 class="mb-0 mt-3">Verdeling extra criteria</h3>
<div class="card-body">
    <p>(Deze weergave gaat over enkelvoudige criteria bv. een man met rijbewijs komt zowel in "rijbewijs", "Ja" voor als
        in "man")</p>
    @foreach (var kpv in Model.CriteriaMemberCount)
    {
        <h4>@kpv.Key</h4>
        @foreach (var innerKpv in kpv.Value)
        {
            <div>
                <h5>@innerKpv.Key</h5>
                <div class="progress">
                    <div class="progress-bar"
                         role="progressbar"
                         style="width: @(Model.SuccessfulRegistrationCount == 0 ? 0 : (innerKpv.Value * 100) / Model.SuccessfulRegistrationCount)%"
                         aria-valuenow="@innerKpv.Value"
                         aria-valuemin="0"
                         aria-valuemax="@Model.SuccessfulRegistrationCount">
                        @(Model.SuccessfulRegistrationCount == 0 ? 0 : (innerKpv.Value * 100) / Model.SuccessfulRegistrationCount)%
                    </div>
                </div>
                <p><strong>@innerKpv.Value</strong> out of
                    <strong>@((int)(desiredCriteriaCountDictionary[kpv.Key][innerKpv.Key] * Model.DesiredRegistrationCount))</strong>
                    (<strong>@(desiredCriteriaCountDictionary[kpv.Key][innerKpv.Key] * 100)%</strong> of
                    <strong>@(Model.DesiredRegistrationCount))</strong></p>

            </div>
        }
    }
</div>
