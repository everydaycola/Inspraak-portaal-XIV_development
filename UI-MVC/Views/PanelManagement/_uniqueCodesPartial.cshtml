@model UI_MVC.Models.ViewModels.UniqueCodesViewModel

@{
    var request = Context.Request;
    var baseUrl = $"{request.Scheme}://{request.Host}";
}

<div class="accordion mb-4" id="criteriaAccordion">
    @foreach (var criteriaGroup in Model.panelMembers)
    {
        <div class="accordion-item">
            <h2 class="accordion-header" id="heading-@criteriaGroup.Key">
                <button class="accordion-button collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse-@criteriaGroup.Key"
                        aria-expanded="false"
                        aria-controls="collapse-@criteriaGroup.Key">
                    <strong>Criteria: @criteriaGroup.Key</strong>
                    <div class="d-flex flex-wrap gap-2 align-items-center ms-3">
                        @foreach (var phaseGroup in criteriaGroup.Value)
                        {
                            <span class="badge bg-primary">
                                @if (Model.Phases > 1)
                                {
                                    <span>Phase @phaseGroup.Key: </span>
                                }
                                @phaseGroup.Value.Count codes
                            </span>
                        }
                    </div>
                </button>
            </h2>
            <div id="collapse-@criteriaGroup.Key"
                 class="accordion-collapse collapse"
                 aria-labelledby="heading-@criteriaGroup.Key"
                 data-bs-parent="#criteriaAccordion">
                <div class="accordion-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered align-middle mb-0">
                            <thead class="table-light">
                            <tr>
                                <th>Gegenereerde URL</th>
                                <th>QR Code</th>
                                @if (Model.Phases > 1)
                                {
                                    <th>Phase</th>
                                }
                                <th>via E-mail</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var member in criteriaGroup.Value.SelectMany(phaseGroup => phaseGroup.Value))
                            {
                                <tr>
                                    <td>
                                        <a href="@($"{baseUrl}/Register?UserId={member.PanelMemberId}")">@member.PanelMemberId</a>
                                    </td>
                                    <td>
                                        <a asp-controller="QRCode"
                                           asp-action="DownloadSingleQrCode"
                                           class="btn btn-primary btn-sm"
                                           asp-route-data="@($"{baseUrl}/Register?UserId={member.PanelMemberId}")">
                                            QR code downloaden
                                        </a>
                                    </td>
                                    @if (Model.Phases > 1)
                                    {
                                        <td>@member.Phase</td>
                                    }
                                    <td>
                                        <form asp-controller="QRCode" asp-action="MailQrCode" method="post" class="d-flex flex-column flex-md-row gap-2">
                                            <input type="hidden" name="data"
                                                   value="@($"{baseUrl}/Register?UserId={member.PanelMemberId}")"/>
                                            <input type="email" name="email" placeholder="Emailadres" required
                                                   class="form-control mb-1 mb-md-0"/>
                                            <button type="submit" class="btn btn-primary btn-sm">Mail QRCode</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@for (var i = 1; i <= Model.Phases; i++)
{
    <div class="d-grid gap-2 d-md-flex justify-content-md-start mb-3">
        <a asp-controller="QRCode"
           asp-action="DownloadQrCodesForAllPanelMembers"
           asp-route-panelId="@Model.panelId"
           asp-route-phase="@i"
           class="btn btn-success btn-lg">
            <i class="bi bi-file-earmark-zip me-2"></i>
            Download QR codes voor alle panelleden
            @(Model.Phases > 1 ? $" (Phase {i})" : "")
        </a>
    </div>
}
