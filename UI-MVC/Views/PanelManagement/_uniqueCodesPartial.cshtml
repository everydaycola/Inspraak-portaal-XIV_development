@using UI_MVC.Models.Dto
@model IEnumerable<GroupedUniqueCodesDto>

@{
    var request = Context.Request; // Or ViewContext.HttpContext.Request
    var baseUrl = $"{request.Scheme}://{request.Host}";
    var panelId = Model.First().Members.First().panelId;
}


<div>
    @foreach (var group in Model)
    {
        <div class="card">
            <div class="card-header">
                <button
                    class="btn btn-link"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapse-@group.GroupKey.Replace(" ", "").Replace(",", "-")"
                    aria-expanded="false"
                    aria-controls="collapse-@group.GroupKey.Replace(" ", "").Replace(",", "-")">
                    Criteria: @group.Name
                </button>
            </div>
            <div
                id="collapse-@group.GroupKey.Replace(" ", "").Replace(",", "-")"
                class="collapse">
                <div class="card-body">
                    <table class="table table-striped table-bordered">
                        <thead class="thead-dark">
                        <tr>
                            <th>Member ID</th>
                            <th>Gegenereerde url</th>
                            <th>QR code</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var member in group.Members)
                        {
                            <tr>
                                <td>@member.memberId</td>
                                <td>
                                    <a href="@($"{baseUrl}{member.generatedUri}")">@($"{baseUrl}{member.generatedUri}")</a>
                                </td>
                                <td>
                                    <a asp-action="DownloadSingleQrCode"
                                       class="btn btn-primary mt-2"
                                       asp-route-generatedUrl="@($"{baseUrl}{member.generatedUri}")")>
                                        QR code downloaden voor dit panellid
                                    </a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <a asp-action="DownloadQRCodesForSpecificGroup"
                       asp-route-panelId="@panelId"
                       asp-route-groupName="@group.Name"
                       class="btn btn-primary mt-2">
                        QR codes downloaden voor iedereen in deze criteriagroup
                    </a>
                </div>
            </div>
        </div>
    }
    <a asp-action="DownloadQRCodesForAllGroups"
       asp-route-panelId="@panelId"
       class="btn btn-primary mt-2">
        QR codes downloaden voor ieder lid van dit panel
    </a>
</div>