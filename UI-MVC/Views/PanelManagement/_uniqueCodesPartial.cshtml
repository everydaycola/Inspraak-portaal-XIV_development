@using Microsoft.AspNetCore.Mvc.TagHelpers
@model UI_MVC.Models.Dto.uniqueCodesDto

@{
    var request = Context.Request;
    var baseUrl = $"{request.Scheme}://{request.Host}";
    var panelId = Model.panelId;

    // Default to phase 1 if not specified
    var selectedPhase = 1;
    if (request.Query.TryGetValue("phase", out var phaseValue) && int.TryParse(phaseValue, out var parsedPhase))
    {
        selectedPhase = parsedPhase > 0 && parsedPhase <= Model.Phases ? parsedPhase : 1;
    }
}

<div class="container py-4">
    @if (Model.Phases > 1)
    {
        <div class="row mb-4">
            <div class="col-md-4">
                <form method="get" class="d-flex align-items-center">
                    <label for="phaseSelector" class="me-2">Phase:</label>
                    <select id="phaseSelector" name="phase" class="form-select" onchange="this.form.submit()">
                        @for (var i = 1; i <= Model.Phases; i++)
                        {
                            <option value="@i" selected="@(selectedPhase == i)">Phase @i</option>
                        }
                    </select>

                    @foreach (var param in Context.Request.Query.Where(p => p.Key != "phase"))
                    {
                        <input type="hidden" name="@param.Key" value="@param.Value" />
                    }
                </form>
            </div>
        </div>
    }
    else
    {
        <input type="hidden" id="phaseSelector" name="phase" value="1" />
    }

    <div class="accordion mb-4" id="criteriaAccordion">
        @foreach (var criteriaGroup in Model.panelMembers[selectedPhase])
        {
            <div class="accordion-item">
                <h2 class="accordion-header" id="heading-@criteriaGroup.Key">
                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapse-@criteriaGroup.Key"
                            aria-expanded="false"
                            aria-controls="collapse-@criteriaGroup.Key">
                        <strong>Criteria: @criteriaGroup.Key</strong>
                        <span class="badge bg-primary ms-2">
                            @criteriaGroup.Value.Count
                        </span>
                    </button>
                </h2>
                <div id="collapse-@criteriaGroup.Key"
                     class="accordion-collapse collapse"
                     aria-labelledby="heading-@criteriaGroup.Key"
                     data-bs-parent="#criteriaAccordion">
                    <div class="accordion-body">
                        <table class="table table-striped table-bordered">
                            <thead class="thead-dark">
                            <tr>
                                <th>Gegenereerde URL</th>
                                <th>QR Code</th>
                                <th>via E-mail</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var member in criteriaGroup.Value)
                            {
                                <tr>
                                    <td>@member.PanelMemberId</td>
                                    <td>
                                        <a href="@($"{baseUrl}/Register?UserId={member.PanelMemberId}")">@($"{baseUrl}/Register?UserId={member.PanelMemberId}")</a>
                                    </td>
                                    <td>
                                        <a asp-controller="QRCode"
                                           asp-action="DownloadSingleQrCode"
                                           class="btn btn-primary mt-2"
                                           asp-route-data="@($"{baseUrl}/Register?UserId={member.PanelMemberId}")" )>
                                            QR code downloaden voor dit panellid
                                        </a>
                                    </td>
                                    <td>
                                        <form asp-controller="QRCode" asp-action="MailQrCode" method="post">
                                            <input type="hidden" name="data"
                                                   value="@($"{baseUrl}/Register?UserId={member.PanelMemberId}")"/>
                                            <input type="email" name="email" placeholder="Emailadres" required
                                                   class="form-control mb-1"/>
                                            <button type="submit" class="btn btn-primary">Mail QRCode</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-grid gap-2 d-md-flex justify-content-md-start">
        <a asp-controller="QRCode"
           asp-action="DownloadQrCodesForAllPanelMembers"
           asp-route-panelId="@panelId"
           asp-route-phase="@selectedPhase"
           class="btn btn-success btn-lg">
            <i class="bi bi-file-earmark-zip me-2"></i>
            Download QR codes voor alle panelleden
            @(Model.Phases > 1 ? $" (Phase {selectedPhase})" : "")
        </a>
    </div>
</div>