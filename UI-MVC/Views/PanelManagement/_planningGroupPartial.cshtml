@using Microsoft.AspNetCore.Mvc.TagHelpers
@using UI_MVC.Models.ViewModels
@model PeopleManagementViewModel

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-light">
        <tr>
            <th>Email</th>
            <th>Naam</th>
            <th>Functie</th>
            <th>Aanpassen</th>
        </tr>
        </thead>
        <tbody>

        @foreach (var member in Model.PlanningGroupMembers)
        {
            <tr id="member-row-@member.Id">
                <td>
                    <span id="email-display-@member.Id">@member.User.Email</span>
                    <input type="email" id="email-edit-@member.Id" class="form-control d-none"
                           value="@member.User.Email"/>
                </td>
                <td>
                    <span id="username-display-@member.Id">@member.User.UserName</span>
                    <input type="text" id="username-edit-@member.Id" class="form-control d-none"
                           value="@member.User.UserName"/>
                </td>
                <td>
                    <span id="functie-display-@member.Id">@member.Functie</span>
                    <input type="text" id="functie-edit-@member.Id" class="form-control d-none"
                           value="@member.Functie"/>
                </td>
                <td>
                    <div class="d-flex flex-column flex-md-row gap-2">
                        <button class="btn btn-info inline-edit-save-btn" type="button"
                                data-member-id="@member.Id"
                                data-panel-id="@Model.PanelId"
                                data-mode="edit">
                            Bewerken
                        </button>
                        <a class="btn btn-danger"
                           asp-action="DeletePlanningsGroupmember"
                           asp-route-panelId="@Model.PanelId"
                           asp-route-planningsGroupMemberId="@member.Id">Verwijderen</a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<button class="btn btn-primary mb-3" type="button" data-bs-toggle="collapse" data-bs-target="#createMemberCollapse"
        aria-expanded="false" aria-controls="createMemberCollapse">
    Nieuw plannings groepslid aanmaken
</button>

<div class="collapse" id="createMemberCollapse">
    <partial name="_planningGroupMemberCreationPartial"
             model="new PlanningGroupMemberViewModel { PanelId = Model.PanelId }"/>
</div>
