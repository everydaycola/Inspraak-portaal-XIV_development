@using Microsoft.AspNetCore.Mvc.TagHelpers
@using UI_MVC.Models.ViewModels
@model UI_MVC.Models.Dto.PanelManagementDto

<div class="container mt-4">
    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
        <tr>
            <th>ID</th>
            <th>Email</th>
            <th>Naam</th>
            <th>Functie</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var member in Model.PlanningGroupMembers)
        {
            <tr>
                <td>@member.Id</td>
                <td>@member.User.Email</td>
                <td>@member.User.UserName</td>
                <td>@member.Functie</td>
                <td><a class="btn btn-danger" asp-action="DeletePlanningsGroupmember" asp-route-panelId="@Model.PanelId" asp-route-planningsGroupMemberId="@member.Id">Delete</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
@Html.Partial("_planningGroupMemberCreationPartial", new PlanningGroupMemberViewModel{PanelId = @Model.PanelId})