@model UI_MVC.Models.ViewModels.PeopleManagementViewModel

<div class="container py-4">
    <div class="alert alert-warning text-center" role="alert">
        <h4 class="alert-heading">Meer codes genereren</h4>
        <p> Er zijn <strong>@Model.ExtraCriteriaViewModel.SuccessfulRegistrationCount</strong> van de <strong>@(Model.PanelSize + Model.AmountOfReserveInvites)</strong>
            inschrijvingen gelukt.</p>
        @if (Model.ExtraCriteriaViewModel.SuccessfulRegistrationCount > Model.PanelSize + Model.AmountOfReserveInvites)
        {
            <p>U heeft <strong>@(Model.ExtraCriteriaViewModel.SuccessfulRegistrationCount - Model.PanelSize + Model.AmountOfReserveInvites)</strong> reserve inschrijvingen
            </p>
        }
        else
        {
            <p>U mist nog <strong>@(Model.PanelSize + Model.AmountOfReserveInvites - Model.ExtraCriteriaViewModel.SuccessfulRegistrationCount)</strong> inschrijvingen</p>
        }
        
    </div>

    @if (Model.AnyCrossCriteria || Model.AnyUnknownCriteria)
    {
        <div class="accordion mb-4" id="criteriaAccordion">
            @if (Model.AnyCrossCriteria)
            {
                <div class="accordion-item">
                    <h2 class="accordion-header" id="crossCriteriaHeading">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#crossCriteriaCollapse" aria-expanded="false"
                                aria-controls="crossCriteriaCollapse">
                            Gekruiste criteria
                        </button>
                    </h2>
                    <div id="crossCriteriaCollapse" class="accordion-collapse collapse"
                         aria-labelledby="crossCriteriaHeading" data-bs-parent="#criteriaAccordion">
                        <div class="accordion-body">
                            <partial name="_extraCriteriaStatsCrossPartial" model="Model.ExtraCriteriaViewModel"/>
                        </div>
                    </div>
                </div>
            }

            @if (Model.AnyUnknownCriteria)
            {
                <div class="accordion-item">
                    <h2 class="accordion-header" id="singleCriteriaHeading">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                data-bs-target="#singleCriteriaCollapse" aria-expanded="false"
                                aria-controls="singleCriteriaCollapse">
                            Niet gekruiste / onbekende criteria
                        </button>
                    </h2>
                    <div id="singleCriteriaCollapse" class="accordion-collapse collapse"
                         aria-labelledby="singleCriteriaHeading" data-bs-parent="#criteriaAccordion">
                        <div class="accordion-body">
                            <partial name="_extraCriteriaStatsPartial" model="Model.ExtraCriteriaViewModel"/>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">Geen criteria</h4>
            <p class="mb-0">Er zijn geen criteria ingesteld voor dit panel.</p>
        </div>
    }
    
    <p>Dit panel heeft een actuele response rate van <strong>@((double)100 * Model.ExtraCriteriaViewModel.SuccessfulRegistrationCount / Model.TotalInvitesNeeded)%</strong> (@Model.ExtraCriteriaViewModel.SuccessfulRegistrationCount van de @Model.TotalInvitesNeeded)</p>
    <!-- New Phase Form -->
    <div class="d-flex justify-content-center my-4">
        <form method="post" asp-controller="PanelManagement" asp-action="NewPhase"
              class="card shadow-lg border-0 rounded-3" style="max-width: 550px; width: 100%;">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0 text-center">Nieuwe Fase Starten</h5>
            </div>
            <div class="card-body p-4">
                <input type="hidden" name="guid" value="@Model.PanelId"/>

                <div class="alert alert-info mb-3">
                    <i class="bi bi-info-circle me-2"></i>
                    Als u een correctie wilt doen aan de response rate, dan kan u dit hier doen.
                    Er zal berekend worden hoeveel uitnodigingen er nog nodig zijn en deze zullen aangemaakt worden.
                </div>

                <div class="mb-4">
                    <label for="newResponseRate" class="form-label fw-bold">Response Rate</label>
                    <div class="input-group">
                        <input id="newResponseRate" type="number" name="newResponseRate"
                               min="0" max="100"
                               class="form-control form-control-lg"
                               placeholder="Laat leeg voor originele response rate"/>
                        <span class="input-group-text">%</span>
                    </div>
                    <small class="text-muted">Voer een waarde tussen 0 en 100 in</small>
                </div>

                <div class="d-grid">
                    <button class="btn btn-primary btn-lg" type="submit">
                        <i class="bi bi-arrow-right-circle me-2"></i>Start Nieuwe Fase
                    </button>
                </div>
            </div>
        </form>
    </div>
    <hr>
    <div class="d-flex flex-column flex-md-row justify-content-center gap-2">
        <a asp-action="Index" class="btn btn-secondary px-4 py-2 mb-2 mb-md-0">Terug</a>
        <form method="post" asp-controller="Register" asp-action="RegisterRandomUsers"
              class="d-flex flex-column flex-md-row align-items-stretch gap-2">
            <input type="hidden" name="guid" value="@Model.PanelId"/>
            <input type="number" name="count" min="1" class="form-control w-auto" placeholder="aantal"/>
            <button class="btn btn-primary px-4 py-2" type="submit">voeg dummy users toe</button>
        </form>
    </div>
</div>
