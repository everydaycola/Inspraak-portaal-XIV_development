@model UI_MVC.Models.ViewModels.PeopleManagementViewModel

@{
    Layout = "_layout";
}
@section Scripts
{
    <script src="~/dist/people.entry.js" type="module"></script>
}
<div class="container py-5">
    <h2 class="m-4">People</h2>

    <!-- Main Cards Section -->
    <div class="row g-4 row-cols-1 row-cols-md-2 mb-4">
        <div class="col">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title">Unieke codes per criteria</h5>
                    <partial name="_uniqueCodesPartial" model="Model.UniqueCodesViewModel"/>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title">Planningsgroep</h5>
                    <partial name="_planningGroupPartial" model="Model"/>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Cards Section -->
    <div class="row g-4 row-cols-1 row-cols-sm-2 mb-4">
        <div class="col">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <h5 class="card-title">Meer codes aanmaken</h5>
                    <button class="btn btn-warning mt-3"
                            data-bs-toggle="modal"
                            data-bs-target="#NewCodesModal"
                            data-panel-id="@Model.PanelId">
                        Meer codes aanmaken
                    </button>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm border-0 h-100 ">
                <div class="card-body d-flex flex-column justify-content-start">
                    <h5 class="card-title">Aangemelde personen</h5>
                    <partial name="_listOfPotentialPanelMembersPartial" model="Model"/>
                </div>
            </div>
            </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="NewCodesModal" tabindex="-1" aria-labelledby="NewCodesLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="NewCodesLabel">Meer codes aanmaken</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
            </div>
            <div class="modal-body">
                <div id="NewCodesModalContent">
                    <partial name="_generateMoreCodesPartial" model="Model"/>
                </div>
            </div>
        </div>
    </div>
</div>
