@model UI_MVC.Models.ViewModels.NewPanelViewModel

@{
    ViewBag.Title = "nieuw panel aanmaken";
    Layout = "_Layout";
}

@section Scripts{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/dist/panelCreation.entry.js" type="module"></script>
}

<div class="container mt-5">
    <div class="row m-2">
        <h2>Nieuw panel aanmaken</h2>
    </div>
    <div class="card mt-4 shadow-sm border-0">
        <div class="card-body">
            <div class="mb-4">
                <form id="new-panel-form" method="post" asp-controller="Panel" asp-action="AddNewPanel">
                    <div asp-validation-summary="ModelOnly"></div>

                    <div class="d-flex flex-column">
                        <h5 class="card-title">Informatie</h5>

                        <!-- Name Input -->
                        <div class="row py-2">
                            <div class="col-12 col-md-6">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label class="card-text mb-1" for="name"><strong>Naam:</strong></label>
                                    <span class="text-danger small" asp-validation-for="Name"></span>
                                </div>
                                <input id="name" asp-for="Name" class="form-control" type="text"
                                       placeholder="Panel rond alcoholgebruik" />
                            </div>
                        </div>

                        <!-- Subregions -->
                        <div id="subregions-container" class="py-2">
                            <strong class="card-text">Gemeente, stad, dorp, organisatie...</strong>
                            <span id="error-subregions" class="text-danger"></span>

                            <!-- Initial Subregion (matches dynamic structure) -->
                            <div class="mb-2 subRegion subregion-0">
                                <div class="row mb-1">
                                    <div class="col-6">
                                        <span id="subregion-0-name-msg"
                                              class="text-danger field-validation-valid"></span>
                                    </div>
                                    <div class="col-6">
                                        <span id="subregion-0-size-msg"
                                              class="text-danger field-validation-valid"></span>
                                    </div>
                                </div>
                                <div class="row g-2 align-items-center">
                                    <div class="col-12 col-md-6 mb-2 mb-md-0">
                                        <input id="subregion-0-name" name="SubRegions[0].Name"
                                               placeholder="Naam" type="text"
                                               class="form-control" required/>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <input id="subregion-0-size" name="SubRegions[0].Size"
                                               placeholder="Grootte" type="number"
                                               class="form-control subregion-size-input" required/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Add Subregion Button -->
                        <div class="row">
                            <div class="col-12 col-md-4">
                                <a id="sub-region-btn" type="button"
                                   class="btn btn-primary w-100 my-2">
                                    Deelgemeente of Wijk Toevoegen
                                </a>
                            </div>
                        </div>

                        <!-- Rates Section -->
                        <div class="row py-2 g-3">
                            <div class="col-12 col-md-4">
                                <div class="input-group">
                                    <label class="input-group-text" for="reserve">
                                        <strong>Reserve %</strong>
                                    </label>
                                    <input id="reserve" asp-for="ReservePercentage" min="0"
                                           class="form-control" type="number" placeholder="5"/>
                                    <span class="input-group-text">%</span>
                                </div>
                                <span class="text-danger" asp-validation-for="ReservePercentage"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <div class="input-group">
                                    <label class="input-group-text" for="sample-rate">
                                        <strong>Sample rate</strong>
                                    </label>
                                    <input id="sample-rate" asp-for="SampleRate" min="0.001" step=".001"
                                           class="form-control" type="number" placeholder="0.5"/>
                                    <span class="input-group-text">%</span>
                                </div>
                                <span class="text-danger" asp-validation-for="SampleRate"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <div class="input-group">
                                    <label class="input-group-text" for="response-rate">
                                        <strong>Response rate</strong>
                                    </label>
                                    <input id="response-rate" asp-for="ResponseRate" min="2" max="10"
                                           class="form-control" type="number" placeholder="2"/>
                                    <span class="input-group-text">%</span>
                                </div>
                                <span class="text-danger" asp-validation-for="ResponseRate"></span>
                            </div>
                        </div>

                        <!-- Panel Size -->
                        <div class="row py-2">
                            <div class="col-12">
                                <p class="card-text panel-size-output">Panelgrootte:</p>
                            </div>
                        </div>
                    </div>

                    <!-- Criteria Section -->
                    <div class="d-flex flex-column mt-4">
                        <h5 class="card-title">Criteria</h5>
                        <div id="criteria-container">
                            <span id="criteria-warning"></span>
                        </div>
                        <div class="row mt-4">
                            <div class="col-12 col-md-3">
                                <button id="criteria-btn" type="button"
                                        class="btn btn-primary w-100 my-2">
                                    Criteria Toevoegen
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="mt-4 text-center text-md-start">
                        <button class="btn btn-primary w-100 w-md-auto" type="submit">
                            Aanmaken
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
