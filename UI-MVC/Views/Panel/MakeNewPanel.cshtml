@model UI_MVC.Models.Dto.NewPanelDto

@{
    ViewBag.Title = "nieuw panel aanmaken";
    Layout = "_Layout";
}

@section Scripts{
    <script src="~/dist/panelCreation.entry.js" type="module"></script>
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Nieuw panel aanmaken</h3>
        </div>
        <div class="card-body">
            <div class="mb-4">
                <form method="post" asp-controller="Panel" asp-action="AddNewPanel">
                <div class="d-flex flex-column">
                    <h5 class="card-title">Informatie</h5>
                    <div class="d-flex flex-row py-2">
                        <label class="card-text pe-4" for="name"><strong>Naam:</strong></label>
                        <input id="name" asp-for="Name" class="border border-1 rounded-2" type="text" placeholder="Panel rond alcoholgebruik"/>
                    </div>
                    @*
                    TODO Deelgemeneent toevoegen
                    - knopje [deelgemeente/wijk toevoegen]
                    - Naam en Grootte
                    *@
                    <div class="d-flex flex-row py-2">
                        <button class="btn btn-primary">Deelgemeente of Wijk Toevoegen</button>
                    </div>
                    
                    <div class="d-flex flex-row py-2">
                        <label class="card-text pe-4" for="size"><strong>Grootte:</strong></label>
                        <input id="size" asp-for="Size" class="border border-1 rounded-2" type="number" placeholder="150"/>
                    </div>

                    <div class="d-flex flex-row py-2">
                        <label class="card-text pe-4" for="sample-rate"><strong>Sample rate:</strong></label>
                        <p><input id="sample-rate" asp-for="SampleRate" min="0.001" step=".001" class="border border-1 rounded-2" type="number" placeholder="0.5"/>%</p>
                    </div>
                </div>

                <div class="d-flex flex-column">
                    <h5 class="card-title">Criteria</h5>
                    <div class="mt-4">
                        <h6><strong>Sex verdeling</strong></h6>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><strong>Man:</strong> 40%</li>
                            <li class="list-group-item"><strong>Vrouw:</strong> 60%</li>
                        </ul>
                    </div>

                    <div class="mt-4">
                        <h6><strong>Leeftijd verdeling</strong></h6>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><strong>20-29:</strong> 20%</li>
                            <li class="list-group-item"><strong>30-39:</strong> 60%</li>
                            <li class="list-group-item"><strong>40-49:</strong> 20%</li>
                        </ul>
                    </div>
                </div>

                <div class="mt-4">
                        <button class="btn btn-primary" type="submit">Aanmaken</button>
                </div>
                </form>
                <div class="mt-4">
                    <h5 class="text-warning">TEMPORARY</h5>
                    <form method="post" asp-controller="Panel" asp-action="AddDefaultPanel">
                        <button class="btn btn-primary" type="submit">Default Panel Aanmaken</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>