@* @model TModel *@

@{
    ViewBag.Title = "nieuw panel aanmaken";
    Layout = "_Layout";
}
@section Scripts{
    <script src="~/dist/panelCreation.entry.js" type="module"></script>
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Nieuw panel aanmaken</h3>
        </div>
        <div class="card-body">
            <div class="mb-4">
                <h5 class="card-title">Criteria van default panel</h5>
                <p class="card-text"><strong>Naam:</strong> Panel rond alcoholgebruik</p>
                <p class="card-text"><strong>Grootte:</strong> 150</p>
                <p class="card-text"><strong>Sample rate:</strong> 0.5%</p>

                <div class="mt-4">
                    <h6><strong>Sex verdeling</strong></h6>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><strong>Man:</strong> 40%</li>
                        <li class="list-group-item"><strong>Vrouw:</strong> 60%</li>
                    </ul>
                </div>

                <div class="mt-4">
                    <h6><strong>Leeftijd verdeling</strong></h6>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><strong>20-29:</strong> 20%</li>
                        <li class="list-group-item"><strong>30-39:</strong> 60%</li>
                        <li class="list-group-item"><strong>40-49:</strong> 20%</li>
                    </ul>
                </div>

                <div class="mt-4">
                    <form method="post" asp-controller="Panel" asp-action="AddDefaultPanel">
                        <button class="btn btn-primary" type="submit">Create Panel</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>