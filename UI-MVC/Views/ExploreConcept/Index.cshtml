@using System.Text.Json
@model UI_MVC.Models.ViewModels.ExploreConceptViewModels.ExploreConceptViewModel

@{
    ViewData["Title"] = "Verkenning Burgerpanel";
}

@section Scripts{
    <script src="~/dist/exploreConcept.entry.js" type="module"></script>
}

<div class="container mt-5">
    <div class="row g-4">
        <!-- Card 1: Wat is een burgerpanel? -->
        <div class="col-12 col-lg-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h2>Wat is een burgerpanel?</h2>
                    <p>
                        Een <b>burgerpanel</b> is een krachtige methode om inwoners direct te betrekken bij belangrijke beslissingen en vraagstukken. Het brengt een diverse groep burgers samen die representatief is voor de bevolking. Deze deelnemers krijgen de tijd en middelen om zich te verdiepen in een onderwerp, expertise te horen van verschillende kanten, en met elkaar in gesprek te gaan.
                    </p>
                    <p>
                        Het doel? Tot <b>doordachte aanbevelingen</b> komen die breed gedragen worden en de complexiteit van de samenleving weerspiegelen. Burgerpanels zijn een uitstekende manier om de stem van de burger echt te laten meetellen en zo tot betere beslissingen te komen.
                    </p>
                </div>
            </div>
        </div>
        <!-- Card 2: Hoe werkt een burgerpanel via het Inspraak Portaal? -->
        <div class="col-12 col-lg-6">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3>Hoe werkt een burgerpanel via het Inspraak Portaal?</h3>
                    <p>
                        Via het Inspraak Portaal begeleiden we je stap voor stap bij het opzetten en uitvoeren van jouw burgerpanel:
                    </p>
                    <ul>
                        <li>
                            <b>Samenstelling:</b> We helpen je een diverse en representatieve groep deelnemers samen te stellen.
                        </li>
                        <li>
                            <b>Informatievoorziening:</b> De deelnemers ontvangen uitgebreide en neutrale informatie over het vraagstuk.
                        </li>
                        <li>
                            <b>Dialoog en deliberatie:</b> Geleid door ervaren facilitators, gaan de deelnemers met elkaar in gesprek, wisselen standpunten uit en wegen argumenten af.
                        </li>
                        <li>
                            <b>Expertise en input:</b> Er worden experts en belanghebbenden uitgenodigd om de deelnemers van alle relevante informatie te voorzien.
                        </li>
                        <li>
                            <b>Aanbevelingen:</b> Uiteindelijk formuleren de deelnemers gezamenlijk concrete aanbevelingen voor de organisatie of overheid.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Form and Conclusion (Single Card Beneath) -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h3 class="mb-0">Ontdek of een burgerpanel iets voor jou is</h3>
                    <form id="exploreconcept-form" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="d-flex flex-column">
                            @for (int i = 0; i < Model.Questions.Count; i++)
                            {
                                <div class="card mb-4 shadow-sm">
                                    <div class="card-body">
                                        <input type="hidden" name="SubmittedAnswers[@i].QuestionId" value="@Model.Questions[i].Id"/>

                                        <h5 class="card-title">@Model.Questions[i].Question</h5>

                                        @if (Model.Questions[i].AnswerOptions != null && Model.Questions[i].AnswerOptions.Any())
                                        {
                                            <div class="d-flex flex-column mt-3">
                                                @foreach (var option in Model.Questions[i].AnswerOptions)
                                                {
                                                    <div class="form-check mb-2">
                                                        <input class="form-check-input" type="radio"
                                                               id="question-@Model.Questions[i].Id-option-@option.Id"
                                                               name="SubmittedAnswers[@i].SelectedAnswerOptionId"
                                                               value="@option.Id"
                                                               data-impacts='@Html.Raw(JsonSerializer.Serialize(option.AnswerOptionImpacts))'
                                                               required
                                                               @(Model.SubmittedAnswers.Any(sa => sa.QuestionId == Model.Questions[i].Id && sa.SelectedAnswerOptionId == option.Id) ? "checked" : "")/>
                                                        <label class="form-check-label"
                                                               for="question-@Model.Questions[i].Id-option-@option.Id">
                                                            @option.AnswerOptionText
                                                        </label>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="text-muted">Geen antwoordopties beschikbaar voor deze vraag.</p>
                                        }

                                        <span asp-validation-for="@Model.SubmittedAnswers[@i].SelectedAnswerOptionId" class="text-danger"></span>
                                    </div>
                                </div>
                            }

                            <div class="mt-4 text-center">
                                <button class="btn btn-primary btn-lg" type="submit">Resultaat bekijken</button>
                            </div>
                        </div>
                    </form>
                    <h2 class="text-center mt-4">Aanbeveling</h2>
                    <p id="conclusiefield" class="text-center"></p>
                </div>
            </div>
        </div>
    </div>
</div>