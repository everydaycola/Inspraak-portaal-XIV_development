@model DAL.Organisation

@{
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Nieuwe oraganisatie aanmaken</h3>
            <div class="card-body">
                <div class="mb-4">
                    <form id="new-organisation-form" method="post" asp-controller="Organisation"
                          asp-action="OrganisationCreation">
                        <div asp-validation-summary="ModelOnly"></div>
                        <div class="d-flex flex-column">
                            <h5 class="card-title">Organisatienaam</h5>
                            <div class="d-flex flex-row py-2">
                                <label class="card-text pe-4" for="name"><strong>Naam:</strong></label>
                                <input id="name" asp-for="Name" class="border border-1 rounded-2 col-3" type="text"
                                       placeholder="Organisatienaam"/>
                                <span class="text-danger" asp-validation-for="Name"></span>
                            </div>

                        </div>
                        <div class="mt-4">
                            <button class="btn btn-primary" type="submit">Aanmaken</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>