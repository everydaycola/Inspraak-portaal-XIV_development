@using BL.Managers
@using DAL
@using Domain
@using Domain.Tenant
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using UI_MVC.TempTenant
@inject Organisation Organisation
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"]</title>
    <script src="~/dist/site.entry.js" type="module"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <link rel="stylesheet" href="~/dist/site.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>
<div class="large-grid-container">
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-4 mb-lg-0" style="background-color:@Organisation.BackgroundColor">
        <div class="container-fluid mb-2">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                @if (Organisation != null && Organisation.LogoImageName != null)
                {
                    <img src="@Url.Action("GetFile", "Storage", new { fileName = Organisation.LogoImageName })" class="img-fluid mt-2" style="max-width: 100px; height: auto;"/>
                }
                else
                {
                    <img src="~/images/icons/inspraak_portaal_light_mode.svg" class="navbar-icon-head" alt="Inspraak portaal logo" style="@(Organisation.IsTextColorWhite ? "filter: invert(1);" : "") max-width:100px; height: auto;" />
                }
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link @(Organisation.IsTextColorWhite ? "text-white" : "text-dark")" asp-area="" asp-controller="Home" asp-action="Index">
                            <img src="~/images/home_icon.svg" class="navbar-icon" alt="Home" style="@(Organisation.IsTextColorWhite ? "filter: invert(1);" : "")"/>
                            <p class="nav-link-description">Home</p>
                        </a>
                    </li>
                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole(CustomIdentityConstants.OrganisatieRole))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(Organisation.IsTextColorWhite ? "text-white" : "text-dark")" asp-area="" asp-controller="Panel" asp-action="MakeNewPanel">
                                <img src="~/images/panel_create.png" class="navbar-icon" alt="Nieuw panel maken" style="@(Organisation.IsTextColorWhite ? "filter: invert(1);" : "")"/>
                                <p class="nav-link-description">Nieuw panel aanmaken</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Organisation.IsTextColorWhite ? "text-white" : "text-dark")" asp-area="" asp-controller="PanelManagement" asp-action="PanelSelection">
                                <img src="~/images/clipboard.png" class="navbar-icon" alt="Status" style="@(Organisation.IsTextColorWhite ? "filter: invert(1);" : "")"/>
                                <p class="nav-link-description">Status</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Organisation.IsTextColorWhite ? "text-white" : "text-dark")" asp-area="" asp-controller="PanelManagement" asp-action="PanelSelection" asp-route-returnAction="People">
                                <img src="~/images/people.png" class="navbar-icon" alt="Personen" style="@(Organisation.IsTextColorWhite ? "filter: invert(1);" : "")"/>
                                <p class="nav-link-description">Personen</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Organisation.IsTextColorWhite ? "text-white" : "text-dark")" asp-area="" asp-controller="OrganisationManagement" asp-action="Index" asp-route-organisationId="@Organisation.Id">
                                <img src="~/images/settings.png" class="navbar-icon" alt="Organisatie instellingen" style="@(Organisation.IsTextColorWhite ? "filter: invert(1);" : "")"/>
                                <p class="nav-link-description">Organisatie instellingen</p>
                            </a>
                        </li>
                    }
                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole(CustomIdentityConstants.AdminRole))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(Organisation.IsTextColorWhite ? "text-white" : "text-dark")" asp-area="" asp-controller="OrganisationManagement" asp-action="AdminIndex">
                                <img src="~/images/settings.png" class="navbar-icon" alt="Organisatie beheer" style="@(Organisation.IsTextColorWhite ? "filter: invert(1);" : "")"/>
                                <p class="nav-link-description">Organisatie beheer</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Question" asp-action="Index">
                                <img src="~/images/question-sign.png" class="navbar-icon" alt="Questionmark"/>
                                <p class="nav-link-description l-invisible">Vragen Verkenning Concept</p>
                            </a>
                        </li>
                    }
                    @if (User.Identity != null && User.Identity.IsAuthenticated &&
                         (User.IsInRole(CustomIdentityConstants.PanelMemberRole)
                          || (User.IsInRole(CustomIdentityConstants.OrganisatieRole))))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(Organisation.IsTextColorWhite ? "text-white" : "text-dark")" asp-area="" asp-controller="PanelProjectPage" asp-action="Index">
                                <img src="~/images/chatting.png" class="navbar-icon" alt="Project pagina" style="@(Organisation.IsTextColorWhite ? "filter: invert(1);" : "")"/>
                                <p class="nav-link-description">Project pagina</p>
                            </a>
                        </li>
                    }
                </ul>
                <div class="login-partial-wrapper">
                    <partial name="_LoginPartial"/>
                </div>
            </div>
        </div>
    </nav>
    <div id="mainContainer">
        <main id="main" role="main">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top text-muted mt-3 mt-lg-0">
        <div class="container">
            <i class="bi bi-c-circle"></i> 2025 - Inspraak Portaal - Team 14_
        </div>
    </footer>
</div>
</body>
</html>
