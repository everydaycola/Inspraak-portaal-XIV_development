@using BL.Managers
@using DAL
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using UI_MVC.TempTenant
@inject Organisation Organisation
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"]</title>
    <script src="~/dist/site.entry.js" type="module"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <link rel="stylesheet" href="~/dist/site.css">
</head>
<body>
<div class="large-grid-container">
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3" style="background-color:@Organisation.BackgroundColor">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                @if (Organisation != null && Organisation.LogoImageName != null)
                {
                    <img
                        src="@Url.Action("GetFile", "Storage", new { fileName = Organisation.LogoImageName })"
                        class="img-fluid mt-2"/>
                }
                else
                {
                    <img src="~/images/icons/inspraak_portaal_light_mode.svg" class="navbar-icon-head" alt="Inspraak portaal logo"/>

                }
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                            <img src="~/images/home_icon.svg" class="navbar-icon" alt="Home"/>
                            <p class="nav-link-description">Home</p>
                        </a>
                    </li>
                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole(CustomIdentityConstants.OrganisatieRole))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Panel" asp-action="MakeNewPanel">
                                Nieuw
                                Panel Aanmaken
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="PanelManagement"
                               asp-action="PanelSelection">
                                Status
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="PanelManagement"
                               asp-action="PanelSelection" asp-route-returnAction="People">
                                Personen
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="OrganisationManagement"
                               asp-action="Index" asp-route-organisationId="@Organisation.Id">
                                Organisatie instellingen
                            </a>
                        </li>
                    }
                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole(CustomIdentityConstants.AdminRole))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="OrganisationManagement" asp-action="AdminIndex">
                                <img src="~/images/organisation_management.png" class="navbar-icon" alt="User account"/>
                                <p class="nav-link-description l-invisible">Organisatie beheer</p>
                            </a>

                        </li>
                    }
                    @if (User.Identity != null && User.Identity.IsAuthenticated &&
                         (User.IsInRole(CustomIdentityConstants.PanelMemberRole)
                          || (User.IsInRole(CustomIdentityConstants.OrganisatieRole))))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="PanelProjectPage" asp-action="Index">
                                Project pagina
                            </a>
                        </li>
                    }
                </ul>
                <div class="login-partial-wrapper">
                    <partial name="_LoginPartial"/>
                </div>
            </div>
        </div>
    </nav>
    <div id="mainContainer">
        <main role="main" class="d-flex justify-content-center align-items-start" >
            @RenderBody()
        </main>
    </div>
    <footer class="border-top text-muted mt-3 mt-lg-0">
        <div class="container">
            <i class="bi bi-c-circle"></i> 2025 - Inspraak Portaal - Team 14_
        </div>
    </footer>
</div>
</body>
</html>