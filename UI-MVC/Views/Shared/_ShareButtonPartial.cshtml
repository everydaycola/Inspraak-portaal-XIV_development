@model UI_MVC.Models.ViewModels.ShareButtonViewModel

@{
    var currentUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Url.Action("Index", "PanelProjectPage", new { id = Model.PostId })}";
}

<button class="share-btn btn btn-primary btn-sm mt-2"
        data-url="@currentUrl"
        data-title="@Model.Title"
        data-text="@Model.Title"
        data-image="@Model.Image">
    <i class="bi bi-share-fill"></i> Share
</button>

<button class="btn btn-outline-info btn-sm mt-2 copy-link-btn"
        data-clipboard-text="@currentUrl">
    <i class="bi bi-link-45deg"></i> Link kopiëren
</button>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const shareButtons = document.querySelectorAll('.share-btn');
        shareButtons.forEach(button => {
            button.addEventListener('click', function() {
                const url = this.getAttribute('data-url');
                const title = this.getAttribute('data-title');
                const text = title;

                if (navigator.share) {
                    navigator.share({
                        title: title,
                        text: text,
                        url: url,
                    })
                        .then(() => console.log('Succesvol gedeeld'))
                        .catch((error) => console.log('Fout bij delen', error));
                } else {
                    alert('Web sharing API wordt niet ondersteund in deze browser. Kopieer de link handmatig.');
                }
            });
        });

        const copyLinkButtons = document.querySelectorAll('.copy-link-btn');
        copyLinkButtons.forEach(button => {
            button.addEventListener('click', function() {
                const linkToCopy = this.getAttribute('data-clipboard-text');
                const originalText = this.textContent; // Bewaar de originele tekst

                navigator.clipboard.writeText(linkToCopy)
                    .then(() => {
                        this.textContent = 'Gekopieerd!'; // Verander de tekst van de knop
                        setTimeout(() => {
                            this.textContent = originalText; // Herstel de originele tekst na een korte vertraging
                        }, 1500); // Terugzetten na 1.5 seconden
                    })
                    .catch(err => {
                        console.error('Fout bij het kopiëren van de link: ', err);
                        alert('De link kon niet automatisch gekopieerd worden. Kopieer hem handmatig: ' + linkToCopy);
                    });
            });
        });
    });
</script>