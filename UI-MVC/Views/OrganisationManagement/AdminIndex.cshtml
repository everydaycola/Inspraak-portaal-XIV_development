@model UI_MVC.Models.ViewModels.OrganisationsViewmodel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Organisatiebeheer";
}

@section Scripts{
    <script src="~/dist/organisationManagement.entry.js" type="module"></script>
}

<div class="container py-5">
    <h2 class="mb-4 text-center">Organisatie beheer</h2>

    <!-- Search Bar Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <form class="d-flex flex-column flex-sm-row gap-2" role="search" autocomplete="off">
                        <input type="text" id="searchBar" class="form-control flex-grow-1" placeholder="Zoek op organisatienaam..." aria-label="Zoek op organisatienaam"/>
                        <button class="btn btn-primary" type="button" id="searchButton">Zoeken</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Info and Table Section -->
    <div class="row g-4">
        <div class="col-12 col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body d-flex flex-column justify-content-center">
                    <h5 class="card-title">Algemene informatie</h5>
                    <p class="mb-0">Totaal aantal organisaties: <strong>@Model.AmountOfOrganisations</strong></p>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">Organisaties</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead class="table-light">
                            <tr>
                                <th scope="col">Id</th>
                                <th scope="col">Naam</th>
                                <th scope="col" class="text-end" colspan="2">Acties</th>
                            </tr>
                            </thead>
                            <tbody>
                            @if (Model.Organisations != null && Model.Organisations.Any())
                            {
                                foreach (var organisation in Model.Organisations)
                                {
                                    <tr data-id="@organisation.Id">
                                        <td>@organisation.Id</td>
                                        <td data-name>@organisation.Name</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-primary edit-button">Edit</button>
                                        </td>
                                        <td class="text-end">
                                            <form asp-action="AdminOrganisationDelete" asp-controller="OrganisationManagement" method="post" class="d-inline">
                                                <input type="hidden" asp-for="@organisation.Id" name="organisationId" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Weet je zeker dat je deze organisatie wilt verwijderen?');">
                                                    Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center">Geen organisaties gevonden.</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteConfirmationModal" tabindex="-1"
         aria-labelledby="deleteConfirmationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteConfirmationModalLabel">Bevestig Verwijderen</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
                </div>
                <div class="modal-body">
                    Weet je zeker dat je deze organisatie wilt verwijderen?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Verwijderen</button>
                </div>
            </div>
        </div>
    </div>
</div>
