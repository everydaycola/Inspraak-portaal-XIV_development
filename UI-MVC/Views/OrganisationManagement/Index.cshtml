@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model DAL.Organisation

@{
    Layout = "_Layout";
    var isEditing = ViewBag.IsEditing as bool? ?? false;
}

<div class="container mt-5">
    <h2>Organisation Details</h2>

    <form method="post" asp-action="Update">
        <div class="card p-4 shadow-sm">
            <div class="mb-3">
                <input type="hidden" name="organisationId" value="@Model.Id" />
            </div>

            <div class="mb-3">
                <label class="form-label">Name</label>
                @if (isEditing)
                {
                    <input type="text" name="Name" class="form-control" value="@Model.Name" />
                }
                else
                {
                    <p class="form-control-plaintext">@Model.Name</p>
                }
            </div>

            <div class="mb-3">
                <label class="form-label">Background Color</label>
                @if (isEditing)
                {
                    <input type="color" name="BackgroundColor" class="form-control form-control-color" value="@Model.BackgroundColor" />
                }
                else
                {
                    <div style="height: 40px; background-color: @Model.BackgroundColor;"></div>
                }
            </div>

            <div class="mb-3">
                <label class="form-label">Background Image</label>
                @if (isEditing)
                {
                    <input type="text" name="BackgroundImage" class="form-control" value="@Model.BackgroundImage" />
                }
                else
                {
                    <img src="@Model.BackgroundImage" alt="Background Image" class="img-fluid" style="max-height: 200px;" />
                }
            </div>

            <div class="d-flex justify-content-between">
                @if (isEditing)
                {
                    <button type="submit" class="btn btn-success">Update</button>
                    <a asp-action="Index" asp-route-organisationId="@Model.Id" class="btn btn-secondary">Cancel</a>
                }
                else
                {
                    <a asp-action="Edit" asp-route-organisationId="@Model.Id" class="btn btn-primary">Edit</a>
                }
            </div>
        </div>
    </form>
</div>