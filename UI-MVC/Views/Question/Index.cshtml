@model List<UI_MVC.Models.ViewModels.QuestionManagementViewModel>

@{
    ViewData["Title"] = "Alle Vragen";
}

<div class="container mt-5">
    <h2>Alle Vragen</h2>

    <p>
        <a asp-action="Create" class="btn btn-success mb-3">Nieuwe Vraag Toevoegen</a>
    </p>

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Vraag</th>
                    <th>Antwoord Opties</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var question in Model)
                {
                    <tr>
                        <td>@question.Question</td>
                        <td>
                            @if (question.AnswerOptions != null && question.AnswerOptions.Any())
                            {
                                <ul>
                                    @foreach (var option in question.AnswerOptions)
                                    {
                                        <li>@option.AnswerOptionText</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span>Geen antwoord opties</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@question.Id" class="btn btn-sm btn-primary">Bewerken</a>
                            <form asp-action="Delete" asp-route-id="@question.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Weet je zeker dat je deze vraag wilt verwijderen?');">
                                    Verwijderen
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>Er zijn nog geen vragen.</p>
    }
</div>