@using UI_MVC.Models.ViewModels
@using UI_MVC.Models.ViewModels.ExploreConceptViewModels
@using UI_MVC.Models.ViewModels.ExploreConceptViewModels.management
@model QuestionIndexViewModel

@{
    ViewData["Title"] = "Vraagbeheer";
}

@section Scripts {
    <script src="~/dist/exploreConcept.entry.js" type="module"></script>
}

<div class="container mt-5">
    <div class="row">
        <div class="col-8">
            <h2 class="mb-4">Vraagbeheer</h2>
            <div class="card shadow-sm border-0 mb-5">
                <div class="card-body">
                    <partial
                        name="_questionFormPartial"
                        model="@(new QuestionViewModel { ParticipationMethods = Model.ParticipationMethods })">
                    </partial>
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="row">
                <h2 class="mb-4">Participatie methode</h2>
                <div class="card shadow-sm border-0 mb-5">
                    <div class="card-body">
                        <partial name="_participationFormPartial"
                                 model="@(new ParticipationViewModel())"/>
                    </div>
                </div>
            </div>
        </div>
        
        <h3 class="mb-4">Overzicht van vragen</h3>
        @if (@Model.Questions != null && Model.Questions.Any())
        {
            <table class="table table-striped table-hover">
                <thead>
                <tr>
                    <th>Vraagtekst</th>
                    <th>Antwoordopties</th>
                    <th>Acties</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var question in Model.Questions)
                {
                    <tr>
                        <td>@question.Question</td>
                        <td>
                            @if (question.AnswerOptions != null && question.AnswerOptions.Any())
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var option in question.AnswerOptions)
                                    {
                                        <li>
                                            @option.AnswerText |
                                            @foreach (var optionImpact in option.Impacts)
                                            {
                                                @optionImpact.ParticipationMethodName
                                                @optionImpact.ImpactWeight
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span>Geen opties</span>
                            }
                        </td>
                        <td>
                            <a asp-action="EditQuestion" asp-route-id="@question.Id"
                               class="btn btn-sm btn-primary">
                                Bewerken
                            </a>
                            <form asp-action="DeleteQuestionWithAnswerOptions" asp-controller="Question"
                                  method="post" class="d-inline">
                                <input type="hidden" name="questionId" value="@question.Id" />
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Weet je zeker dat je deze vraag en zijn antwoordopties wilt verwijderen?');">
                                    Verwijderen
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <p>Er zijn nog geen vragen om weer te geven.</p>
        }
    </div>

    <h3 class="mb-4">Overzicht van participatie methode</h3>
    @if (@Model.Questions != null && Model.Questions.Any())
    {
        <table class="table table-striped table-hover">
            <thead>
            <tr>
                <th>Naam</th>
                <th>Beschrijving</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var method in Model.ParticipationMethods)
            {
                <tr>
                    <td>@method.Name</td>
                    <td>@method.Description</td>
                    <td>
                        <a asp-action="EditParticipationMethod" asp-controller="Question" asp-route-id="@method.Id" class="btn btn-sm btn-primary">
                            Bewerken
                        </a>
                        <form asp-action="DeleteParticipationMethod" asp-controller="Question" asp-route-id="@method.Id"
                              method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Weet je zeker dat je deze vraag wilt verwijderen?');">
                                Verwijderen
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="liveToast" class="toast align-items-center text-white bg-success border-0" role="alert"
         aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"
                    aria-label="Close"></button>
        </div>
    </div>
    <div id="errorToast" class="toast align-items-center text-white bg-danger border-0" role="alert"
         aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="errorToastMessage"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"
                    aria-label="Close"></button>
        </div>
    </div>
</div>

<!-- Explanation Modal -->
<div class="modal fade" id="explanationModal" tabindex="-1" aria-labelledby="explanationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="explanationModalLabel">Hoe werkt het vraaggewichtensysteem?</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Sluiten"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <!-- Form Section -->
                    <div class="col-md-7">
                        <form id="modalQuestionForm">
                            <div class="mb-3">
                                <label class="form-label">Vraagtekst</label>
                                <input type="text" class="form-control"
                                       name="QuestionToEdit.Question"
                                       value="Over hoeveel maanden beschik je nog voordat de input van de participatie klaar moet
zijn voor de politieke besluitvorming?" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Antwoordopties en gewichten</label>
                                <table class="table table-bordered">
                                    <thead>
                                    <tr>
                                        <th>Antwoorden</th>
                                        <th>Burgerpanel <i class="bi bi-info-circle" data-bs-toggle="tooltip"
                                                           title="Bijv. Online enquête"></i></th>
                                        <th>Enquéte <i class="bi bi-info-circle" data-bs-toggle="tooltip"
                                                       title="Bijv. Workshop"></i></th>
                                        <th>Informatieve campagne <i class="bi bi-info-circle" data-bs-toggle="tooltip"
                                                                     title="Bijv. Expertreview"></i></th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    <tr>
                                        <td>
                                            <input type="text"
                                                   class="form-control"
                                                   placeholder="Meer dan 6 maanden" required>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[1].Weight"
                                                   class="form-control" value="10">
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[2].Weight"
                                                   class="form-control" value="0">
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[3].Weight"
                                                   class="form-control" value="0">
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <input type="text"
                                                   class="form-control"
                                                   placeholder="Tussen 3 en 6 maanden" required>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[1].Weight"
                                                   class="form-control" value="0">
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[2].Weight"
                                                   class="form-control" value="10">
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[3].Weight"
                                                   class="form-control" value="0">
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <input type="text"
                                                   class="form-control"
                                                   placeholder="1 tot 3 maanden" required>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[1].Weight"
                                                   class="form-control" value="0">
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[2].Weight"
                                                   class="form-control" value="0">
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[3].Weight"
                                                   class="form-control" value="10">
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <input type="text"
                                                   name="QuestionToEdit.AnswerOptions[0].AnswerOptionText"
                                                   class="form-control"
                                                   placeholder="Minder dan 1 maand" required>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[1].Weight"
                                                   class="form-control" value="0">
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[2].Weight"
                                                   class="form-control" value="0">
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[3].Weight"
                                                   class="form-control" value="100">
                                        </td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>
                        </form>
                    </div>

                    <!-- Explanation Section -->
                    <div class="col-md-5 border-start">
                        <div class="p-3">
                            <h5><i class="bi bi-lightbulb"></i> Werking in 4 stappen:</h5>
                            <ol class="list-group list-group-numbered">
                                <li class="list-group-item d-flex align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Vraag formuleren</div>
                                        Gebruik duidelijke, neutrale vraagstelling
                                    </div>
                                </li>
                                <li class="list-group-item d-flex align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Antwoordopties definiëren</div>
                                        Minimaal 2 opties, maximaal 5
                                    </div>
                                </li>
                                <li class="list-group-item d-flex align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Gewichten toekennen</div>
                                        Gebruik positieve/negatieve waarden (-10 tot +10)
                                    </div>
                                </li>
                                <li class="list-group-item d-flex align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Impact analyseren</div>
                                        Real-time scoreoverzicht per methode
                                    </div>
                                </li>
                            </ol>

                            <div class="alert alert-info mt-3">
                                <i class="bi bi-exclamation-circle"></i>
                                <strong>Tip:</strong> Houd de som van gewichten per vraag rond 0 voor neutrale impact
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Sluiten</button>
            </div>
        </div>
    </div>
</div>