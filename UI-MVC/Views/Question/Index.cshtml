@using Microsoft.EntityFrameworkCore
@using UI_MVC.Models.ViewModels
@using UI_MVC.Models.ViewModels.ExploreConceptViewModels.management
@model QuestionIndexViewModel

@{
    ViewData["Title"] = "Vraagbeheer";
}

@section Scripts {
    <script src="~/dist/exploreConcept.entry.js" type="module"></script>
}

<div class="container mt-5">
    <div class="row g-4 align-items-stretch">
        <!-- Vraagbeheer Formulier -->
        <div class="col-lg-8">
            <h2 class="m-4">Vraagbeheer</h2>
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    @if(Model.ParticipationMethods.Count() != 0){
                        <partial name="_questionFormPartial"
                                 model="@(new QuestionViewModel { ParticipationMethods = Model.ParticipationMethods })"/>
                    }
                    else
                    {
                        <p>Het is niet mogelijk vragen toe te voegen zonder paricipatie methoden</p>
                        }
                </div>
            </div>
        </div>
        <!-- Participatie methode Formulier -->
        <div class="col-lg-4">
            <h2 class="m-4">Participatiemethode</h2>
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <partial name="_participationFormPartial"
                             model="@(new ParticipationViewModel())" />
                </div>
            </div>
        </div>
    </div>

    <!-- Overzicht van vragen in cards -->
    <h3 class="m-4 mt-5">Overzicht van vragen</h3>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (Model.Questions != null && Model.Questions.Any())
        {
            @foreach (var question in Model.Questions)
            {
                <div class="col">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body d-flex flex-column">
                            <strong>Vraag:</strong>
                            <h6 class="card-title mb-2">@question.Question</h6>
                            <div class="mb-3">
                                <strong>Antwoordopties:</strong>
                                @if (question.AnswerOptions != null && question.AnswerOptions.Any())
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var option in question.AnswerOptions)
                                        {
                                            <li class="mb-1">
                                                <div class="d-flex align-items-center flex-wrap">
                                                    <span class="fw-semibold me-2">@option.AnswerText</span>
                                                    @foreach (var impact in option.Impacts)
                                                    {
                                                        <span class="badge bg-light border text-dark me-1 mb-1">
                                                            @impact.ParticipationMethodName: <span class="fw-bold">@impact.ImpactWeight</span>
                                                        </span>
                                                    }
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted">Geen opties</span>
                                }
                            </div>
                            <div class="mt-auto d-flex gap-2">
                                @if (Model.ParticipationMethods.Count() != 0)
                                {
                                    <a asp-action="EditQuestion" asp-route-id="@question.Id"
                                       class="btn btn-sm btn-outline-primary flex-fill">
                                        <i class="bi bi-pencil"></i> Bewerken
                                    </a>
                                }
                                <form asp-action="DeleteQuestionWithAnswerOptions" asp-controller="Question"
                                      method="post" class="flex-fill">
                                    <input type="hidden" name="questionId" value="@question.Id"/>
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100"
                                            onclick="return confirm('Weet je zeker dat je deze vraag en zijn antwoordopties wilt verwijderen?');">
                                        <i class="bi bi-trash"></i> Verwijderen
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col">
                <div class="alert alert-info">Er zijn nog geen vragen om weer te geven.</div>
            </div>
        }
    </div>

    <!-- Overzicht van participatiemethoden in cards -->
    <h3 class="m-4 mt-5">Overzicht van participatiemethoden</h3>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (Model.ParticipationMethods != null && Model.ParticipationMethods.Any())
        {
            @foreach (var method in Model.ParticipationMethods)
            {
                <div class="col">
                    <div class="card shadow-sm h-100 border-0">
                        @*images/ indicates a local (default) file*@
                        @if (method.ImageUri.StartsWith("images/"))
                        {
                            <img src="@method.ImageUri"
                                 class="card-img-top object-fit-cover custom-card-img"
                                 alt="participatie methode foto">
                        }
                        else
                        {
                            <img src="@Url.Action("GetFile", "Storage", new { fileName = @method.ImageUri })"
                                 class="card-img-top object-fit-cover custom-card-img"
                                 alt="participatie methode foto">
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@method.Name</h5>
                            <p class="card-text text-muted flex-grow-1">@method.Description</p>
                            <div class="mt-auto d-flex gap-2">
                                <a asp-action="EditParticipationMethod" asp-controller="Question" asp-route-id="@method.Id"
                                   class="btn btn-sm btn-outline-primary flex-fill" title="Bewerken">
                                    <i class="bi bi-pencil"></i> Bewerken
                                </a>
                                <form asp-action="DeleteParticipationMethod" asp-controller="Question" asp-route-id="@method.Id"
                                      method="post" class="flex-fill">
                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100" title="Verwijderen"
                                            onclick="return confirm('Weet je zeker dat je deze participatiemethode wilt verwijderen?');">
                                        <i class="bi bi-trash"></i> Verwijderen
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col">
                <div class="alert alert-info">Er zijn nog geen participatiemethoden om weer te geven.</div>
            </div>
        }
    </div>
</div>

<!-- Explanation Modal -->
<div class="modal fade" id="explanationModal" tabindex="-1" aria-labelledby="explanationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="explanationModalLabel">Hoe werkt het vraaggewichtensysteem?</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Sluiten"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <!-- Form Section -->
                    <div class="col-md-7">
                        <form id="modalQuestionForm">
                            <div class="mb-3">
                                <label class="form-label">Vraagtekst</label>
                                <input type="text" class="form-control"
                                       name="QuestionToEdit.Question"
                                       value="Over hoeveel maanden beschik je nog?" required readonly>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Antwoordopties en gewichten</label>
                                <table class="table table-bordered">
                                    <thead>
                                    <tr>
                                        <th>Antwoorden</th>
                                        <th>Burgerpanel <i class="bi bi-info-circle" data-bs-toggle="tooltip"
                                                           title="Bijv. Online enquête"></i></th>
                                        <th>Enquéte <i class="bi bi-info-circle" data-bs-toggle="tooltip"
                                                       title="Bijv. Workshop"></i></th>
                                        <th>Informatieve campagne <i class="bi bi-info-circle" data-bs-toggle="tooltip"
                                                                     title="Bijv. Expertreview"></i></th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    <tr>
                                        <td>
                                            <input type="text"
                                                   class="form-control"
                                                   placeholder="Meer dan 6 maanden" required readonly>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[1].Weight"
                                                   class="form-control" value="10" readonly>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[2].Weight"
                                                   class="form-control" value="2" readonly>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[3].Weight"
                                                   class="form-control" value="1" readonly>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <input type="text"
                                                   class="form-control"
                                                   placeholder="Tussen 3 en 6 maanden" required readonly>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[1].Weight"
                                                   class="form-control" value="4" readonly>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[2].Weight"
                                                   class="form-control" value="10" readonly>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[3].Weight"
                                                   class="form-control" value="2" readonly>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <input type="text"
                                                   class="form-control"
                                                   placeholder="1 tot 3 maanden" required readonly>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[1].Weight"
                                                   class="form-control" value="3" readonly>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[2].Weight"
                                                   class="form-control" value="1" readonly>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[3].Weight"
                                                   class="form-control" value="10" readonly>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <input type="text"
                                                   name="QuestionToEdit.AnswerOptions[0].AnswerOptionText"
                                                   class="form-control"
                                                   placeholder="Minder dan 1 maand" required readonly>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[1].Weight"
                                                   class="form-control" value="5" readonly>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[2].Weight"
                                                   class="form-control" value="5" readonly>
                                        </td>
                                        <td>
                                            <input type="number"
                                                   name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[3].Weight"
                                                   class="form-control" value="100" readonly>
                                        </td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>
                        </form>
                    </div>

                    <!-- Explanation Section -->
                    <div class="col-md-5 border-start">
                        <div class="p-3">
                            <h5><i class="bi bi-lightbulb"></i> Werking in 4 stappen:</h5>
                            <ol class="list-group list-group-numbered">
                                <li class="list-group-item d-flex align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Vraag formuleren</div>
                                        Gebruik duidelijke, neutrale vraagstelling
                                    </div>
                                </li>
                                <li class="list-group-item d-flex align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Antwoordopties definiëren</div>
                                        Minimaal 2 opties, maximaal 5
                                    </div>
                                </li>
                                <li class="list-group-item d-flex align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Gewichten toekennen</div>
                                    </div>
                                </li>
                                <li class="list-group-item d-flex align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Impact analyseren</div>
                                        Real-time scoreoverzicht per methode
                                    </div>
                                </li>
                            </ol>

                            <div class="alert alert-info mt-3">
                                <i class="bi bi-exclamation-circle"></i>
                                <strong>Tip:</strong> Houd de som van gewichten per vraag rond 0 voor neutrale impact
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Sluiten</button>
            </div>
        </div>
    </div>
</div>