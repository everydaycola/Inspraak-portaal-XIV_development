@model UI_MVC.Models.ViewModels.ExploreConceptViewModels.QuestionIndexViewModel

@{
    ViewData["Title"] = "Vraagbeheer";
}

@section Scripts {
    <script src="~/dist/exploreConcept.entry.js" type="module"></script>
}

<div class="container mt-5">
    <div class="row">
        <h2 class="mb-4">Vraagbeheer</h2>
        <div class="card shadow-sm border-0 mb-5">
            <div class="card-body">
                <form id="questionForm" asp-action="AddOrUpdate" asp-controller="Question" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" data-valmsg-summary="true"></div>
                    <input type="hidden" asp-for="QuestionToEdit.Id"/>
                    <div class="mb-3">
                        <label asp-for="QuestionToEdit.Question" class="form-label">Vraagtekst</label>
                        <input type="text" asp-for="QuestionToEdit.Question" class="form-control" placeholder="Voer de vraagtekst in" required/>
                        <span asp-validation-for="QuestionToEdit.Question" class="text-danger"></span>
                    </div>
                    <button type="button" class="btn btn-info"
                            data-bs-toggle="modal"
                            data-bs-target="#explanationModal">
                        <i class="bi bi-question-lg"></i>
                    </button>
                    <table id="answerWeightTable">
                        <input type="hidden" id="amountOfParticipationMethods" value="@Model.ParticipationMethods.Count()"/>
                        <tr>
                            <th>Antwoorden</th>
                            @foreach (var partMethod in Model.ParticipationMethods)
                            {
                                <th>@partMethod.Name</th>
                            }
                        </tr>
                        <tr>
                            <td>
                                <input type="text" name="QuestionToEdit.AnswerOptions.AnswerOptionText" class="form-control me-2" placeholder="Antwoordtekst" value="" required/>
                            </td>
                            @foreach (var partMethod in Model.ParticipationMethods)
                            {
                                <td>
                                    <input type="number" name="QuestionToEdit.AnswerOptions.Weight" class="form-control me-2" placeholder="Gewicht" value="" required/>
                                </td>
                            }
                        </tr>
                        <tr>
                            <td>
                                <input type="text" name="QuestionToEdit.AnswerOptions.AnswerOptionText" class="form-control me-2" placeholder="Antwoordtekst" value="" required/>
                            </td>
                            @foreach (var partMethod in Model.ParticipationMethods)
                            {
                                <td>
                                    <input type="number" name="QuestionToEdit.AnswerOptions.Weight" class="form-control me-2" placeholder="Gewicht" value="" required/>
                                </td>
                            }
                        </tr>
                    </table>
                    <div class="mb-3">
                        <label class="form-label">Antwoordopties</label>
                        <!--<div id="answerOptionsContainer">
                            @* Render existing options if model has them (e.g., after validation error) *@
                            @if (Model.QuestionToEdit.AnswerOptions != null)
                            {
                                @for (int i = 0; i < Model.QuestionToEdit.AnswerOptions.Count; i++)
                                {
                                    <div class="d-flex align-items-center mb-2 answer-option-row">
                                        <input type="hidden" name="QuestionToEdit.AnswerOptions[@i].Id" value="@Model.QuestionToEdit.AnswerOptions[i].Id"/>
                                        <input type="text" name="QuestionToEdit.AnswerOptions[@i].AnswerOptionText" class="form-control me-2" placeholder="Antwoordtekst" value="@Model.QuestionToEdit.AnswerOptions[i].AnswerOptionText" required/>
                                        <input type="number" name="QuestionToEdit.AnswerOptions[@i].Weight" class="form-control me-2" placeholder="Gewicht" value="@Model.QuestionToEdit.AnswerOptions[i].Weight" required/>
                                        <button type="button" class="btn btn-sm btn-outline-danger remove-answer-option">X</button>
                                    </div>
                                }
                            }
                        </div>-->
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="addAnswerOption">
                            <i class="bi bi-plus-circle"></i> Optie toevoegen
                        </button>
                        @* This span will display validation errors for the AnswerOptions collection itself (e.g., MinLength) *@
                        <span asp-validation-for="QuestionToEdit.AnswerOptions" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-success" id="questionSubmitBtn">Vraag toevoegen</button>
                    <button type="button" class="btn btn-secondary ms-2" id="newQuestionBtn">Nieuwe vraag</button>
                </form>
            </div>
        </div>
        <div class="row">
            <h2 class="mb-4">Participatie methode</h2>
            <div class="card shadow-sm border-0 mb-5">
                <div class="card-body">
                    <form id="participationMethodForm" asp-action="AddParticipationMethod" asp-controller="Question" method="post">
                        <div class="mb-3">
                            <label for="name" class="form-label">Naam</label>
                            <input type="text" class="form-control" id="name" name="name" required>
                        </div>
                        <div class="mb-3">
                            <label for="description" class="form-label">Beschrijving</label>
                            <textarea class="form-control" id="description" name="description" rows="3" required></textarea>
                        </div>
                        <span asp-validation-for="QuestionToEdit.AnswerOptions" class="text-danger"></span>
                        <button type="submit" class="btn btn-primary">Toevoegen</button>
                    </form>
                </div>
            </div>
        </div>

        <hr class="my-5">

        <h3 class="mb-4">Overzicht van vragen</h3>
        @if (@Model.Questions != null && Model.Questions.Any())
        {
            <table class="table table-striped table-hover">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Vraagtekst</th>
                    <th>Antwoordopties</th>
                    <th>Acties</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var question in Model.Questions)
                {
                    <tr>
                        <td>@question.Id</td>
                        <td>@question.Question</td>
                        <td>
                            @if (question.AnswerOptions != null && question.AnswerOptions.Any())
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var option in question.AnswerOptions)
                                    {
                                        <li>
                                            @option.AnswerOptionText |
                                            @foreach (var optionImpact in option.AnswerOptionImpacts)
                                            {
                                                @optionImpact.ParticipationMethodName
                                                @optionImpact.ContributingWeight
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span>Geen opties</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-primary edit-question-button" data-question-id="@question.Id">Bewerken</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <p>Er zijn nog geen vragen om weer te geven.</p>
        }
    </div>

    <h3 class="mb-4">Overzicht van participatie methode</h3>
    @if (@Model.Questions != null && Model.Questions.Any())
    {
        <table class="table table-striped table-hover">
            <thead>
            <tr>
                <th>Naam</th>
                <th>Beschrijving</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var method in Model.ParticipationMethods)
            {
                <tr>
                    <td>@method.Name</td>
                    <td>@method.Description</td>
                    <td>
                        <form asp-action="DeleteParticipationMethod" asp-controller="Question" asp-route-id="@method.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Weet je zeker dat je deze vraag wilt verwijderen?');">
                                Verwijderen
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="liveToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastMessage"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
    <div id="errorToast" class="toast align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="errorToastMessage"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<!-- Explanation Modal -->
<div class="modal fade" id="explanationModal" tabindex="-1" aria-labelledby="explanationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="explanationModalLabel">Hoe werkt het vraaggewichtensysteem?</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Sluiten"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <!-- Form Section -->
                    <div class="col-md-7">
                        <form id="modalQuestionForm">
                            <div class="mb-3">
                                <label class="form-label">Vraagtekst</label>
                                <input type="text" class="form-control" 
                                       name="QuestionToEdit.Question" 
                                       value="Over hoeveel maanden beschik je nog voordat de input van de participatie klaar moet
zijn voor de politieke besluitvorming?" required>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label">Antwoordopties en gewichten</label>
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Antwoord</th>
                                            <th>Burgerpanel <i class="bi bi-info-circle" data-bs-toggle="tooltip" title="Bijv. Online enquête"></i></th>
                                            <th>Enquéte <i class="bi bi-info-circle" data-bs-toggle="tooltip" title="Bijv. Workshop"></i></th>
                                            <th>Informatieve campagne <i class="bi bi-info-circle" data-bs-toggle="tooltip" title="Bijv. Expertreview"></i></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    <tr>
                                        <td>
                                            <input type="text" 
                                                   name="QuestionToEdit.AnswerOptions[0].AnswerOptionText" 
                                                   class="form-control" 
                                                   placeholder="Meer dan 6 maanden" required>
                                        </td>
                                        <td><input type="number" name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[1].Weight" class="form-control" value="10"></td>
                                        <td><input type="number" name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[2].Weight" class="form-control" value="0"></td>
                                        <td><input type="number" name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[3].Weight" class="form-control" value="0"></td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <input type="text" 
                                                   name="QuestionToEdit.AnswerOptions[0].AnswerOptionText" 
                                                   class="form-control" 
                                                   placeholder="Tussen 3 en 6 maanden" required>
                                        </td>
                                        <td><input type="number" name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[1].Weight" class="form-control" value="0"></td>
                                        <td><input type="number" name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[2].Weight" class="form-control" value="10"></td>
                                        <td><input type="number" name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[3].Weight" class="form-control" value="0"></td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <input type="text" 
                                                   name="QuestionToEdit.AnswerOptions[0].AnswerOptionText" 
                                                   class="form-control" 
                                                   placeholder="1 tot 3 maanden" required>
                                        </td>
                                        <td><input type="number" name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[1].Weight" class="form-control" value="0"></td>
                                        <td><input type="number" name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[2].Weight" class="form-control" value="0"></td>
                                        <td><input type="number" name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[3].Weight" class="form-control" value="10"></td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <input type="text" 
                                                   name="QuestionToEdit.AnswerOptions[0].AnswerOptionText" 
                                                   class="form-control" 
                                                   placeholder="Minder dan 1 maand" required>
                                        </td>
                                        <td><input type="number" name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[1].Weight" class="form-control" value="0"></td>
                                        <td><input type="number" name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[2].Weight" class="form-control" value="0"></td>
                                        <td><input type="number" name="QuestionToEdit.AnswerOptions[0].WeightsPerMethod[3].Weight" class="form-control" value="100"></td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>
                        </form>
                    </div>
                    
                    <!-- Explanation Section -->
                    <div class="col-md-5 border-start">
                        <div class="p-3">
                            <h5><i class="bi bi-lightbulb"></i> Werking in 4 stappen:</h5>
                            <ol class="list-group list-group-numbered">
                                <li class="list-group-item d-flex align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Vraag formuleren</div>
                                        Gebruik duidelijke, neutrale vraagstelling
                                    </div>
                                </li>
                                <li class="list-group-item d-flex align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Antwoordopties definiëren</div>
                                        Minimaal 2 opties, maximaal 5
                                    </div>
                                </li>
                                <li class="list-group-item d-flex align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Gewichten toekennen</div>
                                        Gebruik positieve/negatieve waarden (-10 tot +10)
                                    </div>
                                </li>
                                <li class="list-group-item d-flex align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Impact analyseren</div>
                                        Real-time scoreoverzicht per methode
                                    </div>
                                </li>
                            </ol>
                            
                            <div class="alert alert-info mt-3">
                                <i class="bi bi-exclamation-circle"></i>
                                <strong>Tip:</strong> Houd de som van gewichten per vraag rond 0 voor neutrale impact
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Sluiten</button>
            </div>
        </div>
    </div>
</div>