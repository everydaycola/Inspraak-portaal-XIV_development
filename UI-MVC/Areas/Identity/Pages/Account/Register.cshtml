@page
@using DAL
@model RegisterModel
@inject Organisation Organisation
@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5">
    <h1 class="m-4">@ViewData["Title"]</h1>

    <div class="card p-0 mt-2 m-4">
        <div class="card-body">
            <div class="row g-0">
                <!-- Left image column -->
                <div class="col-md-5 d-flex align-items-center justify-content-center" style="background:#f8f9fa;">
                    @if (Organisation != null && (Organisation.BackgroundImage != null && Organisation.BackgroundImage != ""))
                    {
                        <img
                            src="@Url.Action("GetFile", "Storage", new { fileName = @Organisation.BackgroundImage })"
                            alt="Vragen" class="img-fluid w-100 h-100" style="object-fit:cover;">
                    }
                    else
                    {
                        <img
                            src="https://media.istockphoto.com/id/1393370540/nl/foto/architecture-in-antwerp-city.jpg?s=612x612&w=0&k=20&c=qsEVkQCLeB2ob-oAMVfIXeex69ZQJqo64L33nSZqqqQ="
                            alt="Vragen" class="img-fluid w-100 h-100" style="object-fit:cover;">
                    }
                </div>

                <!-- Right form column -->
                <div class="col-md-7">
                    <section class="m-4">
                        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            <h2 class="mb-4">Maak een nieuw account aan</h2>
                            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                            <div class="form-floating mb-3">
                                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                                <label asp-for="Input.Email">Email</label>
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>
                            <div class="form-floating mb-3">
                                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                                <label asp-for="Input.Password">Wachtwoord</label>
                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                            </div>
                            <div class="form-floating mb-3">
                                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                                <label asp-for="Input.ConfirmPassword">Bevestig wachtwoord</label>
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                            </div>
                            <div class="form-floating mb-3">
                                <select asp-for="Input.SelectedRole" class="form-control" aria-required="true">
                                    @foreach (var role in Model.Input.Roles)
                                    {
                                        <option value="@role.Value">@role.Text</option>
                                    }
                                </select>
                                <label asp-for="Input.SelectedRole">Rol</label>
                                <span asp-validation-for="Input.SelectedRole" class="text-danger"></span>
                            </div>
                            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Registreren</button>
                        </form>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
