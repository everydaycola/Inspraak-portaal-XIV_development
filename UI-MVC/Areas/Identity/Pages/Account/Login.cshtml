@page
@using DAL
@using Domain.Tenant
@model LoginModel
@inject Organisation Organisation

@{
    ViewData["Title"] = "Log in";
}

<div class="container mt-5">
    <h1 class="m-4">@ViewData["Title"]</h1>

    <div class="card p-0 mt-2 m-4">
        <div class="card-body">
            <div class="row g-0">
                <div class="col-md-5 d-flex align-items-center justify-content-center" style="background:#f8f9fa;">
                    @if (Organisation != null && (Organisation.BackgroundImage != null && Organisation.BackgroundImage != ""))
                    {
                        <img
                            src="@Url.Action("GetFile", "Storage", new { fileName = @Organisation.BackgroundImage })"
                            alt="Vragen" class="img-fluid w-100 h-100" style="object-fit:cover;">
                    }
                    else
                    {
                        <img
                            src="~/images/default-detail-image.jpg"
                            alt="Vragen" class="img-fluid w-100 h-100" style="object-fit:cover;">
                    }

                </div>

                <div class="col-md-7">


                    <div class="row">
                        <div>
                            <section class="m-4">
                                <form id="account" method="post">
                                    <h2 class="mb-4">Inloggen op jouw account.</h2>
                                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.Email" class="form-control" autocomplete="username"
                                               aria-required="true"
                                               placeholder="name@example.com"/>
                                        <label asp-for="Input.Email" class="form-label">Email</label>
                                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.Password" class="form-control"
                                               autocomplete="current-password"
                                               aria-required="true" placeholder="password"/>
                                        <label asp-for="Input.Password" class="form-label">Password</label>
                                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                                    </div>
                                    <div class="checkbox mb-3">
                                        <label asp-for="Input.RememberMe" class="form-label">
                                            <input class="form-check-input" asp-for="Input.RememberMe"/>
                                            Onthoud mij op deze computer
                                        </label>
                                    </div>
                                    <div>
                                        <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Log
                                            in
                                        </button>
                                    </div>
                                    <div>
                                        <!-- Still need actual logic o reset the PW.<p>
                                            <a id="forgot-password" asp-page="./ForgotPassword">Forgot your
                                                password?</a>
                                        </p>-->
                                        <a class="w-100 btn btn-lg btn-secondary mt-4" asp-page="./Register"
                                           asp-route-returnUrl="@Model.ReturnUrl">Register as
                                            a new user</a>
                                        <!--Currently we don't confirm emails.<p>
                                            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend
                                                email
                                                confirmation</a>
                                        </p>-->
                                    </div>
                                </form>
                            </section>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <section class="mt-4">
        <h3 class="text-warning"> Should be removed on release.</h3>
        <h3>All existing users: </h3>
        <hr/>

        <table class="table table-bordered table-striped">
            <thead class="thead-dark">
            <tr>
                <th></th>
                <th>Email</th>
                <th>Password</th>
                <th>Role</th>
                <th>login</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>admin</td>
                <td>
                    <input type="text" class="form-control form-control-sm"
                           value="admin@ip14.com" readonly
                           onclick="this.select()"></td>
                <td>
                    <input type="text" class="form-control form-control-sm" value="Admin123!"
                           readonly
                           onclick="this.select()"></td>
                <td>Admin</td>
                <th>
                    <form method="post">
                        <input asp-for="Input.Email" value="admin@ip14.com" type="hidden"/>
                        <input asp-for="Input.Password" value="Admin123!" type="hidden"/>
                        <button type="submit" class="btn btn-primary">Log in</button>
                    </form>
                </th>
            </tr>
            <tr>
                <td>antwerpen</td>
                <td>
                    <input type="text" class="form-control form-control-sm"
                           value="panels@antwerpen.be" readonly
                           onclick="this.select()"></td>
                <td>
                    <input type="text" class="form-control form-control-sm"
                           value="Antwerpen123!" readonly
                           onclick="this.select()"></td>
                <td>Organisatie</td>
                <th>
                    <form method="post">
                        <input asp-for="Input.Email" value="panels@antwerpen.be" type="hidden"/>
                        <input asp-for="Input.Password" value="Antwerpen123!" type="hidden"/>
                        <button type="submit" class="btn btn-primary">Log in</button>
                    </form>
                </th>
            </tr>
            </tbody>
        </table>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
